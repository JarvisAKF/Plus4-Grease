+  it('lists only tools mapped to a connected Box slot', () => {
+    // One Box: T4 maps to the external spool, T5 past the Box, and T6 shares 1B.
+    const buttons = qidiBoxToolButtons({ 0: 0, 1: 1, 2: 2, 3: 3, 4: 16, 5: 6, 6: 1 }, slots, null, null)
