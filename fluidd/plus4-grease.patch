+import type { ActionTree } from 'vuex'
+import type { RootState } from '../types'
+import type { QidiBoxState } from './types'
+
+export const actions = {
+  /**
+   * Reset our store
+   */
+  async reset ({ commit }) {
+    commit('setReset')
+  },
+
+  /**
+   * Klipper and the touchscreen read the filament files when they start, so the Box card reads them again after
+   * a Klipper restart or a dropped connection, such as a printer reboot
+   */
+  async resetFilaments ({ commit }) {
+    commit('setResetFilaments')
+  }
+} satisfies ActionTree<QidiBoxState, RootState>
diff --git a/src/store/qidiBox/getters.ts b/src/store/qidiBox/getters.ts
new file mode 100644
index 0000000..648773f
--- /dev/null
+++ b/src/store/qidiBox/getters.ts
@@ -0,0 +1,180 @@
+import type { GetterTree } from 'vuex'
+import type { QidiBoxState } from './types'
+import type { RootState } from '../types'
+import {
+  QIDI_BOX_EXTERNAL_SLOT,
+  qidiBoxSlotNumber,
+  qidiBoxSlots,
+  qidiBoxToolButtons,
+  type QidiBoxSlot,
+  type QidiBoxToolButton
+} from '@/util/qidi-box'
+import {
+  qidiBoxHubSensor,
+  qidiBoxHubSlot,
+  qidiBoxLastError,
+  qidiBoxLoadedSlot,
+  qidiBoxStrandedRecovery,
+  qidiBoxTask,
+  qidiBoxTaskText,
+  qidiBoxToolheadFilament,
+  qidiBoxWarnings,
+  type QidiBoxError,
+  type QidiBoxStepText,
+  type QidiBoxTask
+} from '@/util/qidi-box-task'
+import { qidiBoxDrySettings, qidiBoxHeaterLimit } from '@/util/qidi-box-dry'
+
+export const getters = {
+  getBoxCount: (state, getters, rootState): number => {
+    const boxCount = Number(rootState.printer.printer.save_variables?.variables?.box_count ?? 0)
+
+    return Number.isFinite(boxCount) ? Math.max(0, Math.min(4, boxCount)) : 0
+  },
+
+  getEnabled: (state, getters, rootState): boolean => {
+    return Number(rootState.printer.printer.save_variables?.variables?.enable_box ?? 0) === 1
+  },
+
+  // Firmware 01.01.07.01 drives the Box through multi_color_controller and stores QF filament IDs.
+  getHasController: (state, getters, rootState): boolean => {
+    return rootState.printer.printer.multi_color_controller != null
+  },
+
+  getSlots: (state, getters, rootState): QidiBoxSlot[] => {
+    return qidiBoxSlots(rootState.printer.printer, state.filamentList)
+  },
+
+  getSlot: (state, getters) => (index: number): QidiBoxSlot | undefined => {
+    return (getters.getSlots as QidiBoxSlot[]).find(slot => slot.index === index)
+  },
+
+  // Box N's heater may not exceed the lowest Box temperature limit among its loaded filaments, as on the
+  // touchscreen; a limit of 0 forbids heating. With Plus4 Grease's PLA/TPU drying on, a Box holding PLA or TPU may go
+  // up to pla_max_temp, as GREASE_BOX_DRY allows, but not during a print. Null when no loaded filament has a known
+  // limit.
+  getHeaterLimit: (state, getters, rootState) => (box: number): number | null => {
+    const printer = rootState.printer.printer
+    const settings = qidiBoxDrySettings(printer['gcode_macro _GREASE_BOX_DRY_SETTINGS'])
+    const printing = ['printing', 'paused'].includes(printer.print_stats?.state ?? '')
+
+    return qidiBoxHeaterLimit(getters.getHeaterLimits(box) as number[], settings, printing)
+  },
+
+  // The known Box limits of the filaments loaded in Box N.
+  getHeaterLimits: (state, getters) => (box: number): number[] => {
+    return (getters.getSlots as QidiBoxSlot[])
+      .filter(slot => slot.index !== QIDI_BOX_EXTERNAL_SLOT && Math.floor(slot.index / 4) === box - 1 && slot.present)
+      .map(slot => slot.boxMaxTemp)
+      .filter((limit): limit is number => limit != null)
+  },
+
+  // value_tN maps tool N to the slot it loads.
+  getToolMap: (state, getters, rootState): Record<number, number> => {
+    const variables: Record<string, unknown> = rootState.printer.printer.save_variables?.variables ?? {}
+    const map: Record<number, number> = {}
+
+    for (let tool = 0; tool < 16; tool++) {
+      const slot = qidiBoxSlotNumber(variables[`value_t${tool}`])
+
+      if (slot != null) map[tool] = slot
+    }
+
+    return map
+  },
+
+  // QIDI defines T0 through T15 whatever Boxes are connected, so the toolhead's tool buttons follow the Box instead.
+  getManagesTools: (state, getters, rootState): boolean => {
+    const printer = rootState.printer.printer
+
+    return printer.save_variables?.variables?.box_count != null || printer.multi_color_controller != null
+  },
+
+  // T_MANAGER does nothing while the Box is disabled.
+  getToolButtons: (state, getters, rootState): QidiBoxToolButton[] => {
+    if (!getters.getEnabled) return []
+
+    const currentTool = Number(rootState.printer.printer.save_variables?.variables?.extrude_state)
+
+    return qidiBoxToolButtons(
+      getters.getToolMap,
+      getters.getSlots,
+      getters.getLoadedSlot,
+      Number.isInteger(currentTool) ? currentTool : null
+    )
+  },
+
+  getToolheadFilament: (state, getters, rootState): boolean => {
+    return qidiBoxToolheadFilament(rootState.printer.printer)
+  },
+
+  // The slot feeding the extruder.
+  getLoadedSlot: (state, getters, rootState): number | null => {
+    return qidiBoxLoadedSlot(rootState.printer.printer, getters.getSlots)
+  },
+
+  getLastLoadSlot: (state, getters, rootState): number | null => {
+    return qidiBoxSlotNumber(rootState.printer.printer.save_variables?.variables?.last_load_slot)
+  },
+
+  // Hub sensor; 0 while filament is at the hub. Firmware 01.01.07.01 publishes it only on multi_color_controller.
+  getHubSensor: (state, getters, rootState): number | null => {
+    return qidiBoxHubSensor(rootState.printer.printer)
+  },
+
+  // The Box slot whose filament is at the hub when no Box slot is loaded; only meaningful while the hub sees one.
+  getHubSlot: (state, getters, rootState): number | null => {
+    return qidiBoxHubSlot(rootState.printer.printer, getters.getSlots)
+  },
+
+  getAutoReload: (state, getters, rootState): boolean => {
+    return Number(rootState.printer.printer.save_variables?.variables?.auto_reload_detect ?? 0) === 1
+  },
+
+  // The running Box flow, or the one paused on a failed step.
+  getTask: (state, getters, rootState): QidiBoxTask | null => {
+    return qidiBoxTask(rootState.printer.printer)
+  },
+
+  getTaskText: (state, getters, rootState): QidiBoxStepText | null => {
+    return qidiBoxTaskText(rootState.printer.printer)
+  },
+
+  getFlowPaused: (state, getters): boolean => {
+    return getters.getTask?.paused === true
+  },
+
+  // The error QIDI reported in the console for the failed step.
+  getLastError: (state, getters, rootState): QidiBoxError | null => {
+    return getters.getFlowPaused ? qidiBoxLastError(rootState.console.console.map(entry => entry.message)) : null
+  },
+
+  getWarnings: (state, getters, rootState): string[] => {
+    return qidiBoxWarnings(rootState.printer.printer.multi_color_controller?.box_warning_info)
+  },
+
+  getBusy: (state, getters, rootState, rootGetters): boolean => {
+    return !rootGetters['printer/getKlippyReady'] ||
+      rootState.printer.printer.print_stats?.state === 'printing' ||
+      !!rootState.printer.printer.box_extras?.box_button_state ||
+      getters.getTask != null
+  },
+
+  // Filament stranded between the hub and the toolhead can be unloaded or ejected outside a print, even while a
+  // failed flow is paused; a running flow still blocks it. Only firmware 01.01.07.01's commands handle it.
+  getStrandedRecovery: (state, getters, rootState, rootGetters): boolean => {
+    return rootGetters['printer/getKlippyReady'] &&
+      getters.getHasController &&
+      qidiBoxStrandedRecovery(rootState.printer.printer)
+  },
+
+  // Like VO_RESET_TOOL_MAPPINGS, mappings change only while idle, so a paused print keeps its recovery state.
+  getMappingLocked: (state, getters, rootState): boolean => {
+    return getters.getBusy || rootState.printer.printer.print_stats?.state === 'paused'
+  },
+
+  // Every print goes through the Box slot dialog while a Box is connected, so its slots are always chosen.
+  getShowPrintDialog: (state, getters) => (filename: string): boolean => {
+    return filename !== '' && getters.getBoxCount > 0
+  }
+} satisfies GetterTree<QidiBoxState, RootState>
