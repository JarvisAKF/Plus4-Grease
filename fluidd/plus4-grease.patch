+++ b/src/util/persona.ts
@@ -0,0 +1,201 @@
+// Plus4 Grease personas: a look for the whole page (colors, font, card shapes, logo) and a status line in the top
+// bar that says what the printer is doing in the persona's voice. Picked in Settings > Theme; 'none' is Fluidd's own
+// look. The line only reports what the printer state already shows; it never decides anything.
+
+export type PersonaId = 'none' | 'overdrive'
+
+export interface Persona {
+  id: Exclude<PersonaId, 'none'>;
+  name: string;
+  // Sets the theme's primary color and Vuetify's custom colors while the persona is on.
+  color: string;
+  colors: Record<string, string>;
+  // Shown under the logo and as the status line's label.
+  tagline: string;
+  label: string;
+  // Beside the dashboard's title.
+  heading: string;
+}
+
+export const PERSONAS: Persona[] = [
+  {
+    id: 'overdrive',
+    name: 'Overdrive',
+    color: '#FF3D2E',
+    colors: {
+      appbar: '#0B0B0D',
+      drawer: '#0B0B0D',
+      'card-heading': '#141418',
+      btncolor: '#18181D'
+    },
+    tagline: 'OVERDRIVE',
+    label: 'SYSTEM ›',
+    heading: 'EFFICIENCY MODE: ENFORCED'
+  }
+]
+
+export const persona = (id: string | null | undefined): Persona | undefined => PERSONAS.find(p => p.id === id)
+
+export interface PersonaBox {
+  box: number;
+  drying: boolean;
+  dryTemp: number | null;
+  // The cool-down lock: minutes left, or 0; locked while minutes are left or it's above unlock_temp after heating.
+  locked: boolean;
+  coolMinutes: number;
+  temperature: number | null;
+}
+
+export interface PersonaHeater {
+  name: string;
+  temperature: number;
+  target: number;
+}
+
+export interface PersonaStatus {
+  klippyReady: boolean;
+  // print_stats.state: standby, printing, paused, complete, cancelled, error.
+  state: string;
+  filename: string;
+  // 0 to 1.
+  progress: number;
+  layer: number | null;
+  totalLayers: number | null;
+  speedFactor: number;
+  heaters: PersonaHeater[];
+  boxes: PersonaBox[];
+}
+
+const percent = (value: number) => `${Math.floor(Math.max(0, Math.min(1, value)) * 100)}%`
+
+const shortName = (filename: string) => {
+  const base = filename.split('/').pop() ?? filename
+
+  return base.replace(/\.gcode$/i, '')
+}
+
+// A heater still more than 3 degrees short of its target counts as heating up.
+const heatingUp = (heaters: PersonaHeater[]) => heaters.find(h => h.target > 0 && h.temperature < h.target - 3)
+
+const overdrive = (s: PersonaStatus): string => {
+  if (!s.klippyReady) return 'Klipper is down. Nothing moves until it is back.'
+
+  const name = shortName(s.filename)
+  const layers = s.layer != null && s.totalLayers ? ` Layer ${s.layer} of ${s.totalLayers}.` : ''
+  const speed = Math.round(s.speedFactor * 100)
+
+  switch (s.state) {
+    case 'printing': {
+      const heating = heatingUp(s.heaters)
+
+      if (s.progress <= 0 && heating) {
+        return `Heating ${heating.name}: ${Math.round(heating.temperature)} of ${Math.round(heating.target)}°C. Then we go.`
+      }
+
+      return `${name}: ${percent(s.progress)} done.${layers}${speed === 100 ? ' Holding the line.' : ` Running at ${speed}%.`}`
+    }
+    case 'paused':
+      return `${name} paused at ${percent(s.progress)}. Waiting on you.`
+    case 'complete':
+      return `${name} done. Clear the plate. Next.`
+    case 'cancelled':
+      return `${name} cancelled. Clear the plate.`
+    case 'error':
+      return 'Print stopped on an error. Check the console.'
+  }
+
+  const cooling = s.boxes.find(b => b.locked)
+  const drying = s.boxes.find(b => b.drying)
+
+  if (drying) {
+    return `Box ${drying.box} drying${drying.dryTemp ? ` at ${drying.dryTemp}°C` : ''}. Moisture is the enemy.`
+  }
+
+  if (cooling) {
+    const now = cooling.temperature != null ? `${Math.round(cooling.temperature)}°C` : 'warm'
+    const wait = cooling.coolMinutes > 0 ? ` ${cooling.coolMinutes} min left.` : ''
+
+    return `Box ${cooling.box} cooling at ${now}. PLA and TPU stay locked.${wait}`
+  }
+
+  const heating = heatingUp(s.heaters)
+
+  if (heating) {
+    return `Heating ${heating.name}: ${Math.round(heating.temperature)} of ${Math.round(heating.target)}°C.`
+  }
+
+  return 'Idle. Systems armed. Give me something to print.'
+}
+
+export const personaStatusLine = (id: string | null | undefined, status: PersonaStatus): string => {
+  switch (id) {
+    case 'overdrive':
+      return overdrive(status)
+    default:
+      return ''
+  }
+}
+
+// ---------------------------------------------------------------- Overdrive's print job card
+
+// Speed buttons: M220 values. MAX is the mockup's 220%; Klipper still holds every move to the printer's own velocity
+// and acceleration limits.
+export const personaJobSpeeds: { label: string, value: number }[] = [
+  { label: '100%', value: 100 },
+  { label: '140%', value: 140 },
+  { label: '180%', value: 180 },
+  { label: 'MAX', value: 220 }
+]
+
+export interface PersonaJobInput {
+  filename: string;
+  state: string;
+  // 0 to 100, as Fluidd's time estimates give it.
+  progress: number;
+  layer: number | null;
+  totalLayers: number | null;
+  // Seconds left, or 0 when unknown.
+  left: number;
+  layerHeight: number | null;
+  slicer: string | null;
+}
+
+export interface PersonaJobLayout {
+  name: string;
+  subline: string;
+  done: boolean;
+  progress: number;
+  segments: number;
+  layerText: string;
+  left: number;
+}
+
+export const personaJobLayout = (job: PersonaJobInput): PersonaJobLayout => {
+  const done = job.state === 'complete'
+  const progress = done ? 100 : Math.max(0, Math.min(100, Math.floor(job.progress)))
+  const parts = [
+    job.layerHeight ? `${job.layerHeight} MM LAYERS` : null,
+    job.slicer ? job.slicer.toUpperCase() : null,
+    ['cancelled', 'error'].includes(job.state) ? job.state.toUpperCase() : null
+  ].filter((part): part is string => part != null)
+  const layerText = job.totalLayers
+    ? `LAYER ${done ? job.totalLayers : job.layer ?? 0}/${job.totalLayers}`
+    : 'LAYER —'
+
+  return {
+    name: shortName(job.filename),
+    subline: parts.join(' · '),
+    done,
+    progress,
+    segments: Math.floor(progress * 40 / 100),
+    layerText,
+    left: done ? 0 : Math.max(0, Math.round(job.left))
+  }
+}
+
+export const personaCoolingNotice = (box: number, temperature: number | null, unlockTemp: number, minutes: number) => {
+  const unlocks = `unlocks at ${unlockTemp}°${minutes > 0 ? `, in about ${minutes} min` : ''}.`
+  const when = temperature != null ? `${Math.round(temperature)}° now, it ${unlocks}` : `It ${unlocks}`
+
+  return `Print start locked: Box ${box} holds PLA or TPU and is cooling after heating. ${when}`
+}
diff --git a/src/util/qidi-box-dry.ts b/src/util/qidi-box-dry.ts
new file mode 100644
index 0000000..c9c5fea
