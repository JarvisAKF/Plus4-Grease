+<script lang="ts">
+// Plus4 Grease: drying for one QIDI Box, through GREASE_BOX_DRY and GREASE_BOX_DRY_STOP from the Plus4 Grease
+// --box-dry config (grease/plus4-grease-box-dry.cfg). Klipper keeps the timer and the humidity control, so drying
+// carries on with this page closed. The macro enforces QIDI's filament limit itself; this form only suggests it.
+// With pla_drying on in plus4-grease-box-dry-settings.cfg, PLA and TPU dry too (never during a print), and a Box holding
+// them then stays locked for loading them until it has cooled; this shows that cool-down.
+import { Component, Mixins, Prop, Watch } from 'vue-property-decorator'
+import StateMixin from '@/mixins/state'
+import {
+  QIDI_BOX_EMPTY_LIMIT,
+  qidiBoxCooling,
+  qidiBoxDryLimit,
+  qidiBoxDrySettings,
+  type QidiBoxCooling,
+  type QidiBoxDrySettings,
+  type QidiBoxDryState
+} from '@/util/qidi-box-dry'
+
+@Component({})
+export default class QidiBoxDry extends Mixins(StateMixin) {
+  @Prop({ type: Number, required: true })
+  readonly box!: number
+
+  @Prop({ type: Number, required: true })
+  readonly boxCount!: number
+
+  // Plus4 Grease's --box-dry macros are installed.
+  @Prop({ type: Boolean, default: true })
+  readonly canDry!: boolean
+
+  // QIDI's Box heater limits of the filaments loaded (0 for PLA and TPU); empty when none is known.
+  @Prop({ type: Array, default: () => [] })
+  readonly limits!: number[]
+
+  valid = true
+  temp = 0
+  hours = 4
+  humidity = 0
+
+  get waitKey (): string {
+    return `onQidiBoxDry${this.box}`
+  }
+
+  get settings (): QidiBoxDrySettings {
+    return qidiBoxDrySettings(this.$typedState.printer.printer['gcode_macro _GREASE_BOX_DRY_SETTINGS'])
+  }
+
+  get hasPla (): boolean {
+    return this.limits.includes(0)
+  }
+
+  get maxTemp (): number {
+    return qidiBoxDryLimit(this.limits, this.settings) ?? QIDI_BOX_EMPTY_LIMIT
+  }
+
+  get printing (): boolean {
+    return ['printing', 'paused'].includes(this.$typedState.printer.printer.print_stats?.state ?? '')
+  }
+
+  get state (): QidiBoxDryState {
+    return this.$typedState.printer.printer[`gcode_macro _GREASE_BOX_DRY_${this.box}`] ?? {}
+  }
+
+  get cooling (): QidiBoxCooling {
+    return qidiBoxCooling(this.state, this.$typedState.printer.printer[`heater_generic heater_box${this.box}`]?.temperature,
+      this.settings)
+  }
+
+  get coolingText (): string {
+    const { minutes, temperature, unlockTemp } = this.cooling
+    const temp = temperature ?? '?'
+
+    return minutes > 0
+      ? this.$t('app.qidi_box.dry.cooling_time', { temp, unlock: unlockTemp, minutes }).toString()
+      : this.$t('app.qidi_box.dry.cooling_temp', { temp, unlock: unlockTemp }).toString()
+  }
+
+  get active (): boolean {
+    return Number(this.state.active) === 1
+  }
+
+  // QIDI's own drying (ENABLE_BOX_DRY, as the touchscreen starts it): box_extras.boxes[].dry_state.
+  get qidiBox (): Record<string, any> {
+    return this.$typedState.printer.printer.box_extras?.boxes?.[this.box - 1] ?? {}
+  }
+
+  get qidiDrying (): boolean {
+    return Number(this.qidiBox.dry_state ?? 0) !== 0
+  }
+
+  get qidiTemp (): number {
+    return Math.round(Number(this.qidiBox.box_target_temp ?? this.$typedState.printer.printer[`heater_generic heater_box${this.box}`]?.target ?? 0))
+  }
+
+  get humidityNow (): number | null {
+    const humidity = this.$typedState.printer.printer[`aht20_f heater_box${this.box}`]?.humidity
+
+    return humidity != null ? Math.round(humidity) : null
+  }
+
+  get statusText (): string {
+    const { temp, minutes_left: minutes, humidity, heating } = this.state
+    const parts = [
+      heating
+        ? this.$t('app.qidi_box.dry.status_heating', { temp }).toString()
+        : this.$t('app.qidi_box.dry.status_paused', { temp, humidity: this.humidityNow ?? '?' }).toString(),
+      minutes != null && minutes > 0
+        ? this.$t('app.qidi_box.dry.time_left', { hours: Math.floor(minutes / 60), minutes: minutes % 60 }).toString()
+        : this.$t('app.qidi_box.dry.until_stopped').toString()
+    ]
+
+    if (humidity) parts.push(this.$t('app.qidi_box.dry.keeping', { humidity }).toString())
+    if (Number(this.state.pla) === 1) parts.push(this.$t('app.qidi_box.dry.status_pla').toString())
+
+    return parts.join(' · ')
+  }
+
+  @Watch('maxTemp', { immediate: true })
+  onMaxTempChanged (max: number) {
+    if (!this.temp || this.temp > max) this.temp = max
+  }
+
+  start () {
+    if (!this.valid || this.active || this.qidiDrying || this.maxTemp === 0 || (this.hasPla && this.printing)) return
+
+    this.sendGcode(
+      `GREASE_BOX_DRY BOX=${this.box} TEMP=${Math.round(this.temp)} HOURS=${this.hours} HUMIDITY=${Math.round(this.humidity)}`,
+      this.waitKey
+    )
+  }
+
+  stopQidi () {
+    this.sendGcode(`DISABLE_BOX_DRY BOX=${this.box}`, this.waitKey)
+  }
+
+  stop () {
+    this.sendGcode(`GREASE_BOX_DRY_STOP BOX=${this.box}`, this.waitKey)
+  }
+}
+</script>
+
+<style lang="scss" scoped>
+.qidi-box-dry__form {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(90px, 1fr)) auto;
+  gap: 8px;
+  align-items: center;
+}
+</style>
diff --git a/src/components/widgets/qidiBox/QidiBoxFilamentDialog.vue b/src/components/widgets/qidiBox/QidiBoxFilamentDialog.vue
new file mode 100644
index 0000000..5e01f63
--- /dev/null
+++ b/src/components/widgets/qidiBox/QidiBoxFilamentDialog.vue
@@ -0,0 +1,148 @@
+<template>
+  <app-dialog
+    v-model="open"
+    :title="$t('app.qidi_box.title.edit_slot', { slot: boxSlot.label })"
+    width="420"
+    :save-button-disabled="busy || draft.filament == null"
+    @save="handleSave"
+  >
+    <v-card-text class="pt-4">
+      <v-select
+        v-model="draft.vendor"
+        :items="vendors"
+        :label="$t('app.qidi_box.label.vendor')"
+        class="mb-3"
+        outlined
+        dense
+        hide-details
+      />
+      <v-select
+        v-model="draft.filament"
+        :items="filaments"
+        :label="$t('app.qidi_box.label.filament')"
+        class="mb-3"
+        outlined
+        dense
+        hide-details
+      />
+      <div class="text-caption text--secondary mb-1">
+        {{ $t('app.qidi_box.label.color') }}
+      </div>
+      <div class="d-flex flex-wrap align-center qidi-box-filament-dialog__colors">
+        <div
+          v-for="color in palette"
+          :key="color.id"
+          class="qidi-box-filament-dialog__color"
+          :class="{ 'qidi-box-filament-dialog__color--selected': draft.color === color.id }"
+          :style="{ backgroundColor: color.hex }"
+          :title="color.hex"
+          @click="draft.color = color.id"
+        />
+      </div>
+    </v-card-text>
+  </app-dialog>
+</template>
+
+<script lang="ts">
+// Plus4 Grease: set a Box slot's filament, vendor and color by hand, for any spool, from the choices in QIDI's
+// officiall_filas_list.cfg. Saved exactly as QIDI's own Fluidd and touchscreen save them on the Plus 4's V2.1.1:
+// SAVE_VARIABLE VARIABLE=filament_slotN / vendor_slotN / color_slotN VALUE="<ID from the list>", slot 16 being the
+// external spool. From Valve Oil's QidiBoxFilamentDialog, cut down to that firmware's numeric IDs.
+import { Component, Mixins, Prop, VModel, Watch } from 'vue-property-decorator'
+import StateMixin from '@/mixins/state'
+import { normalizeQidiColor, type QidiBoxSlot } from '@/util/qidi-box'
+
+interface Draft {
+  vendor: string | null;
+  filament: string | null;
+  color: string | null;
+}
+
+@Component({})
+export default class QidiBoxFilamentDialog extends Mixins(StateMixin) {
+  @VModel({ type: Boolean })
+  open!: boolean
+
+  @Prop({ type: Object, required: true })
+  readonly boxSlot!: QidiBoxSlot
+
+  @Prop({ type: Boolean })
+  readonly busy!: boolean
+
+  draft: Draft = { vendor: null, filament: null, color: null }
+
+  get list () {
+    return this.$typedState.qidiBox.filamentList
+  }
+
+  saved (name: 'filament' | 'vendor' | 'color'): string | null {
+    const value = this.$typedState.printer.printer.save_variables?.variables?.[`${name}_slot${this.boxSlot.index}`]
+
+    return value != null && String(value) !== '' ? String(value) : null
+  }
+
+  get vendors () {
+    return Object.entries(this.list?.vendor_list ?? {}).map(([value, text]) => ({ value, text }))
+  }
+
+  get filaments () {
+    return Object.entries(this.list ?? {})
+      .filter(([key, entry]) => /^fila\d+$/.test(key) && entry.filament)
+      .map(([key, entry]) => ({ value: key.slice(4), text: entry.filament }))
+      .sort((a, b) => a.text.localeCompare(b.text))
+  }
+
+  get palette () {
+    return Object.entries(this.list?.colordict ?? {})
+      .map(([id, color]) => ({ id, hex: normalizeQidiColor(color) }))
+      .filter((color): color is { id: string, hex: string } => color.hex != null)
+  }
+
+  @Watch('open', { immediate: true })
+  onOpenChanged (value: boolean) {
+    if (!value) return
+
+    const filament = this.saved('filament')
+
+    this.draft = {
+      vendor: this.saved('vendor'),
+      filament: this.filaments.some(entry => entry.value === filament) ? filament : null,
+      color: this.saved('color')
+    }
+  }
+
+  handleSave () {
+    const { index } = this.boxSlot
+    const { vendor, filament, color } = this.draft
+    const lines: string[] = []
+
+    if (filament == null || this.busy) return
+
+    if (vendor != null && vendor !== this.saved('vendor')) lines.push(`SAVE_VARIABLE VARIABLE=vendor_slot${index} VALUE="${vendor}"`)
+    if (filament !== this.saved('filament')) lines.push(`SAVE_VARIABLE VARIABLE=filament_slot${index} VALUE="${filament}"`)
+    if (color != null && color !== this.saved('color')) lines.push(`SAVE_VARIABLE VARIABLE=color_slot${index} VALUE="${color}"`)
+
+    if (lines.length) this.sendGcode(lines.join('\n'))
+
+    this.open = false
+  }
+}
+</script>
+
+<style scoped>
+.qidi-box-filament-dialog__colors {
+  gap: 6px;
+}
+
+.qidi-box-filament-dialog__color {
+  width: 28px;
+  height: 28px;
+  border-radius: 50%;
+  cursor: pointer;
+  border: 1px solid rgba(128, 128, 128, 0.6);
+}
+
+.qidi-box-filament-dialog__color--selected {
+  border: 3px solid #2196f3;
+}
+</style>
diff --git a/src/components/widgets/qidiBox/QidiBoxFlow.vue b/src/components/widgets/qidiBox/QidiBoxFlow.vue
new file mode 100644
index 0000000..30c5451
--- /dev/null
+++ b/src/components/widgets/qidiBox/QidiBoxFlow.vue
@@ -0,0 +1,522 @@
+<template>
+  <!-- Box units around the filament path hub → toolhead → extruder → nozzle. Strands in the filament's color show
+       what the sensors see: the slot parked at the hub, and the slot loaded to the nozzle. -->
+  <div class="qidi-box-flow">
+    <qidi-box-loaded-summary
+      v-if="layout.narrow"
+      class="mb-3 pa-3 rounded-lg qidi-box-flow__summary"
+      large
+      v-bind="summary"
+    />
+
+    <div
+      ref="diagram"
+      class="qidi-box-flow__diagram"
+    >
+      <svg
+        class="qidi-box-flow__strands"
+        :width="svgWidth"
+        :height="svgHeight"
+        aria-hidden="true"
+      >
+        <template v-for="path in paths">
+          <path
+            v-if="path.slot == null"
+            :key="path.key"
+            :d="path.d"
+            class="qidi-box-flow__guide"
+          />
+          <template v-else>
+            <path
+              :key="`${path.key}:edge`"
+              :d="path.d"
+              class="qidi-box-flow__strand-edge"
+              :class="{ 'qidi-box-flow__strand-edge--contrast': path.contrast }"
+            />
+            <path
+              :key="path.key"
+              :d="path.d"
+              class="qidi-box-flow__strand"
+              :style="{ stroke: path.color ?? undefined }"
+            />
+          </template>
+        </template>
+      </svg>
+
+      <div
+        v-if="!layout.compact"
+        class="qidi-box-flow__tier"
+      >
+        <qidi-box-unit
+          v-for="box in layout.top"
+          :key="`unit:${box}`"
+          v-bind="unitProps(box)"
+          v-on="unitListeners"
+        />
+      </div>
+
+      <div
+        class="qidi-box-flow__rail"
+        :class="{
+          'qidi-box-flow__rail--first': layout.compact,
+          'qidi-box-flow__rail--last': !layout.compact && !layout.bottom.length
+        }"
+      >
+        <div class="qidi-box-flow__path">
+          <template v-if="boxCount">
+            <div
+              class="qidi-box-flow__node"
+              :class="{ 'qidi-box-flow__node--on': hubTriggered }"
+              :title="$t('app.qidi_box.label.hub').toString()"
+            >
+              <span
+                class="qidi-box-flow__sensor"
+                data-port="hub"
+              />
+              <small>{{ hubLabel }}</small>
+            </div>
+            <div class="qidi-box-flow__ptfe">
+              <small>PTFE</small>
+            </div>
+          </template>
+          <div
+            class="qidi-box-flow__node"
+            :class="{ 'qidi-box-flow__node--on': toolheadSlot != null }"
+            :title="$t('app.qidi_box.label.toolhead_sensor').toString()"
+          >
+            <span
+              class="qidi-box-flow__sensor"
+              data-port="th"
+            />
+            <small>{{ $t('app.qidi_box.label.toolhead') }}</small>
+          </div>
+          <div class="qidi-box-flow__node">
+            <span
+              class="qidi-box-flow__extruder"
+              data-port="ex"
+            />
+            <small>{{ $t('app.qidi_box.label.extruder') }}</small>
+          </div>
+          <div
+            class="qidi-box-flow__node"
+            :class="{ 'qidi-box-flow__node--on': nozzleColor != null }"
+          >
+            <span
+              class="qidi-box-flow__nozzle"
+              data-port="noz"
+            >
+              <qidi-box-nozzle :color="nozzleColor" />
+            </span>
+            <small>{{ $t('app.qidi_box.label.nozzle') }}</small>
+          </div>
+        </div>
+
+        <qidi-box-loaded-summary
+          v-if="!layout.narrow"
+          class="qidi-box-flow__inline-summary"
+          :size="40"
+          v-bind="summary"
+        />
+      </div>
+
+      <div
+        v-if="layout.compact || layout.bottom.length"
+        class="qidi-box-flow__tier"
+      >
+        <qidi-box-unit
+          v-for="box in (layout.compact ? layout.top : layout.bottom)"
+          :key="`unit:${box}`"
+          v-bind="unitProps(box)"
+          :below="!layout.compact"
+          v-on="unitListeners"
+        />
+      </div>
+    </div>
+  </div>
+</template>
+
+<script lang="ts">
+import { Component, Prop, Vue } from 'vue-property-decorator'
+import { markRaw } from 'vue'
+import {
+  QIDI_BOX_EXTERNAL_SLOT,
+  qidiBoxSlotLabel,
+  qidiColorNearBackground,
+  type QidiBoxClimate,
+  type QidiBoxReloadGroups,
+  type QidiBoxSlot
+} from '@/util/qidi-box'
+import {
+  qidiBoxFlowConnections,
+  qidiBoxFlowLayout,
+  qidiBoxFlowPath,
+  type QidiBoxFlowLayout
+} from '@/util/qidi-box-flow'
+import QidiBoxUnit from './QidiBoxUnit.vue'
+import QidiBoxNozzle from './QidiBoxNozzle.vue'
+import QidiBoxLoadedSummary from './QidiBoxLoadedSummary.vue'
+
+interface FlowPath {
+  key: string;
+  d: string;
+  slot: number | null;
+  color: string | null;
+  contrast: boolean;
+}
+
+@Component({
+  components: {
+    QidiBoxUnit,
+    QidiBoxNozzle,
+    QidiBoxLoadedSummary
+  }
+})
+export default class QidiBoxFlow extends Vue {
+  @Prop({ type: Array, required: true })
+  readonly slots!: QidiBoxSlot[]
+
+  @Prop({ type: Number, required: true })
+  readonly boxCount!: number
+
+  @Prop({ type: Object, required: true })
+  readonly climates!: Record<number, QidiBoxClimate>
+
+  @Prop({ type: Number, required: true })
+  readonly selected!: number
+
+  @Prop({ type: Number, default: null })
+  readonly loadedSlot!: number | null
+
+  // The slot whose filament the hub sensor sees, and the one at the toolhead sensor.
+  @Prop({ type: Number, default: null })
+  readonly hubSlot!: number | null
+
+  @Prop({ type: Number, default: null })
+  readonly toolheadSlot!: number | null
+
+  @Prop({ type: Boolean })
+  readonly hubTriggered!: boolean
+
+  @Prop({ type: Object, required: true })
+  readonly toolsBySlot!: Record<number, string[]>
+
+  @Prop({ type: Object, required: true })
+  readonly reloadGroups!: QidiBoxReloadGroups
+
+  @Prop({ type: Boolean })
+  readonly busy!: boolean
+
+  @Prop({ type: String, default: null })
+  readonly step!: string | null
+
+  width = 0
+  svgWidth = 0
+  svgHeight = 0
+  paths: FlowPath[] = []
+  pathsKey = ''
+  observer: ResizeObserver | null = null
+  frame = 0
+
+  get layout (): QidiBoxFlowLayout {
+    return qidiBoxFlowLayout(this.width, this.boxCount)
+  }
+
+  get slotByIndex (): Record<number, QidiBoxSlot> {
+    return Object.fromEntries(this.slots.map(slot => [slot.index, slot]))
+  }
+
+  get unitListeners () {
+    return {
+      select: (index: number) => this.$emit('select', index),
+      'tool-click': (entry: { tool: number, slot: number }) => this.$emit('tool-click', entry)
+    }
+  }
+
+  get pathSlot (): QidiBoxSlot | null {
+    const index = this.toolheadSlot ?? this.hubSlot
+
+    return index != null ? this.slotByIndex[index] ?? null : null
+  }
+
+  get summary () {
+    const slot = this.pathSlot
+
+    return {
+      boxSlot: slot,
+      loaded: slot != null && slot.index === this.loadedSlot,
+      tools: slot ? this.toolsBySlot[slot.index] ?? [] : [],
+      busy: this.busy,
+      step: this.step
+    }
+  }
+
+  get hubLabel (): string {
+    const hub = this.$t('app.qidi_box.label.hub').toString()
+
+    return this.hubSlot != null ? `${hub} · ${qidiBoxSlotLabel(this.hubSlot)}` : hub
+  }
+
+  get nozzleColor (): string | null {
+    const slot = this.toolheadSlot != null ? this.slotByIndex[this.toolheadSlot] : null
+
+    return slot ? slot.color ?? '#9e9e9e' : null
+  }
+
+  unitProps (box: number) {
+    const external = box === 0
+
+    return {
+      title: external ? this.$t('app.qidi_box.label.external').toString() : this.$t('app.qidi_box.label.box', { box }).toString(),
+      slots: this.slots.filter(slot => external
+        ? slot.index === QIDI_BOX_EXTERNAL_SLOT
+        : slot.index !== QIDI_BOX_EXTERNAL_SLOT && Math.floor(slot.index / 4) === box - 1),
+      climate: external ? null : this.climates[box] ?? null,
+      external,
+      selected: this.selected,
+      loadedSlot: this.loadedSlot,
+      toolsBySlot: this.toolsBySlot,
+      reloadGroups: this.reloadGroups,
+      spoolSize: this.layout.spoolSize
+    }
+  }
+
+  mounted () {
+    this.width = this.$el.clientWidth
+
+    if (typeof ResizeObserver !== 'undefined') {
+      this.observer = markRaw(new ResizeObserver(() => {
+        this.width = this.$el.clientWidth
+        this.scheduleMeasure()
+      }))
+      this.observer.observe(this.$el)
+
+      const diagram = this.$refs.diagram
+
+      if (diagram instanceof HTMLElement) this.observer.observe(diagram)
+    }
+
+    document.fonts?.ready.then(() => this.scheduleMeasure())
+    this.scheduleMeasure()
+  }
+
+  updated () {
+    this.scheduleMeasure()
+  }
+
+  beforeDestroy () {
+    this.observer?.disconnect()
+    cancelAnimationFrame(this.frame)
+  }
+
+  scheduleMeasure () {
+    if (this.frame) return
+
+    this.frame = requestAnimationFrame(() => {
+      this.frame = 0
+      this.measure()
+    })
+  }
+
+  // The connectors follow the laid-out ports, so they are measured after each render rather than computed.
+  measure () {
+    const diagram = this.$refs.diagram
+
+    if (!(diagram instanceof HTMLElement)) return
+
+    const bounds = diagram.getBoundingClientRect()
+
+    if (bounds.width === 0) return
+
+    const ports = new Map<string, [number, number]>()
+
+    for (const element of Array.from(diagram.querySelectorAll<HTMLElement>('[data-port]'))) {
+      const rect = element.getBoundingClientRect()
+
+      ports.set(element.dataset.port ?? '', [
+        rect.left + rect.width / 2 - bounds.left,
+        rect.top + rect.height / 2 - bounds.top
+      ])
+    }
+
+    const dark = this.$vuetify.theme.dark
+    const paths: FlowPath[] = []
+
+    for (const connection of qidiBoxFlowConnections(this.hubSlot, this.toolheadSlot, this.layout.compact)) {
+      const points = connection.via.flatMap(port => {
+        const point = ports.get(port)
+
+        return point ? [point] : []
+      })
+
+      if (points.length < 2) continue
+
+      const slot = connection.slot != null ? this.slotByIndex[connection.slot] : null
+      const color = slot ? slot.color ?? '#9e9e9e' : null
+
+      paths.push({
+        key: connection.key,
+        d: qidiBoxFlowPath(points, connection.dir),
+        slot: connection.slot,
+        color,
+        contrast: color != null && qidiColorNearBackground(color, dark)
+      })
+    }
+
+    const key = JSON.stringify([bounds.width, bounds.height, paths])
+
+    if (key === this.pathsKey) return
+
+    this.pathsKey = key
+    this.svgWidth = Math.ceil(bounds.width)
+    this.svgHeight = Math.ceil(bounds.height)
+    this.paths = paths
+  }
+}
+</script>
+
+<style lang="scss" scoped>
+.qidi-box-flow__summary {
+  background: var(--qidi-box-tint);
+}
+
+.qidi-box-flow__diagram {
+  position: relative;
+}
+
+.qidi-box-flow__strands {
+  position: absolute;
+  top: 0;
+  left: 0;
+  pointer-events: none;
+}
+
+.qidi-box-flow__diagram > :not(.qidi-box-flow__strands) {
+  position: relative;
+}
+
+.qidi-box-flow__guide {
+  fill: none;
+  stroke: var(--qidi-box-track);
+  stroke-width: 2;
+}
+
+.qidi-box-flow__strand-edge {
+  fill: none;
+  stroke: var(--qidi-box-edge);
+  stroke-width: 6.5;
+  stroke-linecap: round;
+}
+
+.qidi-box-flow__strand-edge--contrast {
+  stroke: var(--qidi-box-contrast);
+  stroke-width: 7.5;
+}
+
+.qidi-box-flow__strand {
+  fill: none;
+  stroke-width: 4;
+  stroke-linecap: round;
+}
+
+.qidi-box-flow__tier {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 12px 10px;
+}
+
+.qidi-box-flow__rail {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: center;
+  gap: 14px 28px;
+  padding: 40px 0;
+}
+
+.qidi-box-flow__rail--first {
+  padding: 4px 0 16px;
+}
+
+.qidi-box-flow__rail--last {
+  padding-bottom: 4px;
+}
+
+.qidi-box-flow__path {
+  display: flex;
+  flex: none;
+  align-items: flex-start;
+}
+
+.qidi-box-flow__node {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 11px;
+  width: 64px;
+  opacity: 0.6;
+}
+
+.qidi-box-flow__node--on {
+  opacity: 1;
+}
+
+.qidi-box-flow__node small {
