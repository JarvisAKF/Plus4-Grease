+// Plus4 Grease personas (Settings > Theme > Persona). Each look applies only under its class on the app root
+// (persona-<id>, set in App.vue), so Fluidd's own look is untouched while the persona is Off. The colors of the top
+// bar, the drawer, card headings and buttons come from Vuetify's theme (src/util/persona.ts); the rest is here.
+
+// Latin only: the printer serves these from its own disk, no internet needed.
+@import "@fontsource/chakra-petch/latin-500.css";
+@import "@fontsource/chakra-petch/latin-600.css";
+@import "@fontsource/chakra-petch/latin-700.css";
+
+@mixin persona-chamfer($size) {
+  clip-path: polygon(#{$size} 0, 100% 0, 100% calc(100% - #{$size}), calc(100% - #{$size}) 100%, 0 100%, 0 #{$size});
+}
+
+// Vuetify's typography classes set their own font with !important.
+$persona-type-classes: '.text-h1, .text-h2, .text-h3, .text-h4, .text-h5, .text-h6, .text-subtitle-1, .text-subtitle-2, .text-body-1, .text-body-2, .text-button, .text-caption, .text-overline, .display-4, .display-3, .display-2, .display-1, .headline, .title, .subheading, .subtitle-1, .subtitle-2, .body-1, .body-2, .caption, .overline';
+
+// ---------------------------------------------------------------- Overdrive
+$od-bg: #070708;
+$od-card: #0E0E11;
+$od-raised: #141418;
+$od-btn: #18181D;
+$od-line: #1C1C22;
+$od-text: #F2F2F4;
+$od-muted: #9C9CA6;
+$od-font: 'Chakra Petch', system-ui, sans-serif;
+
+.v-application.persona-overdrive {
+  font-family: $od-font;
+  font-weight: 500;
+  color: $od-text;
+  background: $od-bg !important;
+
+  #{$persona-type-classes} {
+    font-family: $od-font !important;
+  }
+
+  // Console, editor and code keep their fixed-width font.
+  code, pre, kbd {
+    font-family: monospace !important;
+  }
+
+  .v-main {
+    background: $od-bg;
+  }
+
+  // Top bar: the printer name small and spaced, like the rest of the labels.
+  .printer-title {
+    font-family: $od-font !important;
+    font-size: 13px !important;
+    font-weight: 600 !important;
+    letter-spacing: 0.12em;
+    text-transform: uppercase;
+  }
+
+  .v-app-bar.v-toolbar {
+    box-shadow: none !important;
+    border-bottom: 1px solid $od-line;
+  }
+
+  // Side menu: spaced capitals, the open page marked with the accent on its left edge.
+  .v-navigation-drawer {
+    background-color: #0B0B0D !important;
+    border-right: 1px solid $od-line;
+
+    .v-navigation-drawer__border {
+      display: none;
+    }
+
+    // The Settings page's section list has Fluidd's grey set on it directly.
+    .v-list {
+      background-color: #0B0B0D !important;
+    }
+
+    .v-list-item {
+      border-left: 3px solid transparent;
+      border-radius: 0 !important;
+    }
+
+    .v-list-item--active {
+      border-left-color: var(--v-primary-base);
+      background: $od-btn;
+    }
+
+    .v-list-item__title,
+    .v-list-item .text-caption {
+      font-size: 13px !important;
+      font-weight: 600;
+      letter-spacing: 0.12em;
+      text-transform: uppercase;
+    }
+  }
+
+  // Cards: flat panels with the top-left and bottom-right corners cut.
+  .v-card.theme--dark {
+    background-color: $od-card;
+    box-shadow: none !important;
+    border-radius: 0 !important;
+    @include persona-chamfer(14px);
+  }
+
+  .v-dialog > .v-card,
+  .v-menu__content .v-card {
+    @include persona-chamfer(10px);
+  }
+
+  .collapsable-card-title,
+  .v-card__title {
+    font-family: $od-font !important;
+    font-size: 0.8rem !important;
+    font-weight: 700 !important;
+    letter-spacing: 0.2em !important;
+    text-transform: uppercase;
+    color: $od-muted;
+  }
+
+  .collapsable-card-title .v-icon {
+    color: var(--v-primary-base) !important;
+  }
+
+  .v-subheader {
+    font-weight: 700;
+    letter-spacing: 0.16em;
+    text-transform: uppercase;
+  }
+
+  .theme--dark.v-divider {
+    border-color: $od-line !important;
+  }
+
+  // Buttons: square, cut corners, spaced capitals. Round icon buttons stay round.
+  .v-btn:not(.v-btn--icon):not(.v-btn--fab) {
+    border-radius: 0 !important;
+    font-weight: 700;
+    letter-spacing: 0.12em;
+    @include persona-chamfer(7px);
+  }
+
+  .v-btn-toggle {
+    border-radius: 0 !important;
+  }
+
+  .v-chip {
+    border-radius: 0 !important;
+    font-weight: 600;
+    letter-spacing: 0.08em;
+    @include persona-chamfer(5px);
+  }
+
+  // Inputs: square.
+  .v-text-field--filled > .v-input__control > .v-input__slot,
+  .v-text-field--outlined fieldset,
+  .v-text-field--solo > .v-input__control > .v-input__slot {
+    border-radius: 0 !important;
+  }
+
+  // Progress bars in cards: split into 40 segments.
+  .v-card .v-progress-linear {
+    -webkit-mask-image: repeating-linear-gradient(90deg, #000 0, #000 calc(2.5% - 3px), transparent calc(2.5% - 3px), transparent 2.5%);
+    mask-image: repeating-linear-gradient(90deg, #000 0, #000 calc(2.5% - 3px), transparent calc(2.5% - 3px), transparent 2.5%);
+  }
+
+  // Numbers line up as they change.
+  .v-data-table td,
+  .v-card__text {
+    font-variant-numeric: tabular-nums;
+  }
+
+  .text--secondary {
+    color: $od-muted !important;
+  }
