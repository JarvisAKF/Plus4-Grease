+import { describe, expect, it } from 'vitest'
+import { qidiBoxLoadedSlot, qidiBoxToolheadFilament } from '../qidi-box-task'
+
+// Plus4 Grease: the Plus 4's toolhead sensor is hall_filament_width_sensor, not a filament switch.
+describe('qidiBoxToolheadFilament', () => {
+  const plus4 = (diameter: number, minimum?: number) => ({
+    hall_filament_width_sensor: { Diameter: diameter, Raw: 0, is_active: true },
+    configfile: { settings: minimum == null ? {} : { hall_filament_width_sensor: { min_diameter: minimum } } }
+  })
+
+  it('reads a filament switch where there is one', () => {
+    expect(qidiBoxToolheadFilament({ 'filament_switch_sensor filament_switch_sensor': { filament_detected: true } })).toBe(true)
+    expect(qidiBoxToolheadFilament({ 'filament_switch_sensor filament_switch_sensor': { filament_detected: false } })).toBe(false)
+  })
+
+  it('reads the Plus 4 hall sensor against its min_diameter', () => {
+    expect(qidiBoxToolheadFilament(plus4(1.74, 0.3))).toBe(true)
+    expect(qidiBoxToolheadFilament(plus4(0.1, 0.3))).toBe(false)
+    expect(qidiBoxToolheadFilament(plus4(0.3, 0.3))).toBe(false)
+  })
+
+  it("uses Klipper's 1.0 mm default when min_diameter isn't set", () => {
+    expect(qidiBoxToolheadFilament(plus4(1.2))).toBe(true)
+    expect(qidiBoxToolheadFilament(plus4(0.8))).toBe(false)
+  })
+
+  it('reads no filament without either sensor', () => {
+    expect(qidiBoxToolheadFilament({})).toBe(false)
+  })
+
+  it('finds the external spool loaded on a Plus 4 when no Box slot is synced', () => {
+    const printer = { ...plus4(1.74, 0.3), save_variables: { variables: { slot_sync: 'slot-1' } } }
+
+    expect(qidiBoxLoadedSlot(printer, [])).toBe(16)
+  })
+})
