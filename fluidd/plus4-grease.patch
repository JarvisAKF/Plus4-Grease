+++ b/src/util/qidi-box-dry.ts
@@ -0,0 +1,91 @@
+// Plus4 Grease: the Box drying settings and the cool-down lock, worked out the way plus4-grease-box-dry.cfg works
+// them out, so the card shows what the macros will do. The macros decide; this only follows them.
+
+export interface QidiBoxDrySettings {
+  plaDrying: boolean;
+  plaMaxTemp: number;
+  unlockTemp: number;
+  coolMinutes: number;
+}
+
+export interface QidiBoxDryState {
+  active?: number;
+  temp?: number;
+  minutes_left?: number;
+  humidity?: number;
+  heating?: number;
+  pla?: number;
+  cool_left?: number;
+  hot?: number;
+}
+
+export interface QidiBoxCooling {
+  locked: boolean;
+  minutes: number;
+  temperature: number | null;
+  unlockTemp: number;
+}
+
+// An empty Box: the macro caps it at the highest filament limit in QIDI's list.
+export const QIDI_BOX_EMPTY_LIMIT = 65
+
+// Jinja's int filter: a number truncated, anything else 0. Then clamped, as the macros do.
+const clamped = (value: unknown, low: number, high: number): number => {
+  const number = Math.trunc(Number(value))
+
+  return Math.min(Math.max(Number.isFinite(number) ? number : 0, low), high)
+}
+
+const DEFAULTS = { pla_drying: false, pla_max_temp: 45, unlock_temp: 35, cool_minutes: 30 }
+
+// The _GREASE_BOX_DRY_SETTINGS macro's variables, from plus4-grease-box-dry-settings.cfg.
+export const qidiBoxDrySettings = (macro?: Record<string, unknown> | null): QidiBoxDrySettings => {
+  const values = { ...DEFAULTS, ...(macro ?? {}) }
+
+  return {
+    plaDrying: ['true', '1', 'yes', 'on'].includes(String(values.pla_drying).toLowerCase()),
+    plaMaxTemp: clamped(values.pla_max_temp, 35, 50),
+    unlockTemp: clamped(values.unlock_temp, 30, 45),
+    coolMinutes: clamped(values.cool_minutes, 10, 120)
+  }
+}
+
+// GREASE_BOX_DRY's heater limit for one Box, from QIDI's Box limits of the filaments in it: the lowest; with PLA or
+// TPU in it (QIDI's 0), 0 unless PLA/TPU drying is on, and then no more than pla_max_temp. Null when none is known.
+export const qidiBoxDryLimit = (limits: number[], settings: QidiBoxDrySettings): number | null => {
+  if (!limits.length) return null
+
+  const others = limits.filter(limit => limit > 0)
+  const highest = others.length ? Math.min(...others) : QIDI_BOX_EMPTY_LIMIT
+
+  if (!limits.includes(0)) return highest
+
+  return settings.plaDrying ? Math.min(highest, settings.plaMaxTemp) : 0
+}
+
+// The highest target a Box heater may be given, by GREASE_BOX_DRY's rule: qidiBoxDryLimit, except that a Box holding PLA
+// or TPU isn't heated during a print (or while one is paused). Null when no loaded filament has a known limit.
+export const qidiBoxHeaterLimit = (limits: number[], settings: QidiBoxDrySettings, printing: boolean): number | null => {
+  const limit = qidiBoxDryLimit(limits, settings)
+
+  return limit != null && printing && limits.includes(0) ? 0 : limit
+}
+
+// A Box holding PLA or TPU is locked for loading them, and no print starts, while minutes of its cool-down are left, or
+// while it is above unlock_temp after heating (hot).
+export const qidiBoxCooling = (
+  state: QidiBoxDryState | null | undefined,
+  temperature: number | null | undefined,
+  settings: QidiBoxDrySettings
+): QidiBoxCooling => {
+  const minutes = Math.max(0, Math.trunc(Number(state?.cool_left ?? 0)) || 0)
+  const hot = Number(state?.hot ?? 0) === 1
+  const known = temperature != null && Number.isFinite(temperature)
+
+  return {
+    locked: minutes > 0 || (hot && known && (temperature as number) > settings.unlockTemp),
+    minutes,
+    temperature: known ? Math.round(temperature as number) : null,
+    unlockTemp: settings.unlockTemp
+  }
+}
diff --git a/src/util/qidi-box-flow.ts b/src/util/qidi-box-flow.ts
new file mode 100644
index 0000000..a2cb40a
--- /dev/null
+++ b/src/util/qidi-box-flow.ts
@@ -0,0 +1,109 @@
+import { QIDI_BOX_EXTERNAL_SLOT } from './qidi-box'
+
+// The QIDI Box flow diagram: Box units above (and, when they don't fit in one row, below) the filament path
+// hub → toolhead sensor → extruder → nozzle. Connectors run between named ports: `inlet:<slot>` on each Box slot's
+// inlet sensor, `ext` where the external spool leaves its frame, and `hub`, `th`, `ex`, `noz` along the path.
+
+export type QidiBoxFlowDirection = 'h' | 'v'
+
+export interface QidiBoxFlowConnection {
+  key: string;
+  via: string[];
+  // Curves leave and enter each port horizontally ('h') or vertically ('v').
+  dir: QidiBoxFlowDirection;
+  // The slot whose filament the strand carries; null for the path guide.
+  slot: number | null;
+}
+
+export interface QidiBoxFlowLayout {
+  spoolSize: number;
+  // The loaded-filament summary sits above the diagram rather than beside the path.
+  narrow: boolean;
+  // Too narrow for the diagram: the path sits on top and the units wrap below it, without slot strands.
+  compact: boolean;
+  // Units above the path, then below it (mirrored to face it); Box numbers, with 0 for the external spool.
+  top: number[];
+  bottom: number[];
+}
+
+export const QIDI_BOX_FLOW_NARROW_WIDTH = 520
+export const QIDI_BOX_FLOW_UNIT_GAP = 10
+export const QIDI_BOX_FLOW_EXTERNAL_MIN_WIDTH = 80
+
+const PATH = ['hub', 'th', 'ex', 'noz']
+
+// A spool column is the spool plus its hover padding; a unit is its columns plus padding.
+export const qidiBoxFlowColumnWidth = (spoolSize: number): number => spoolSize + 6
+
+export const qidiBoxFlowUnitWidth = (box: number, spoolSize: number): number => box === 0
+  ? Math.max(qidiBoxFlowColumnWidth(spoolSize) + 16, QIDI_BOX_FLOW_EXTERNAL_MIN_WIDTH)
+  : 4 * qidiBoxFlowColumnWidth(spoolSize) + 3 * 4 + 16
+
+// One row when every unit fits; otherwise the first half of the Boxes above the path and the rest, with the
+// external spool, below it. When neither fits, the compact layout.
+export const qidiBoxFlowLayout = (width: number, boxCount: number): QidiBoxFlowLayout => {
+  const narrow = width <= QIDI_BOX_FLOW_NARROW_WIDTH
+  const spoolSize = narrow ? (boxCount >= 3 ? 32 : 44) : (boxCount >= 2 ? 44 : 52)
+  const units = [...Array.from({ length: boxCount }, (_, i) => i + 1), 0]
+  const fits = (row: number[]) => row.reduce((sum, box) => sum + qidiBoxFlowUnitWidth(box, spoolSize), 0) +
+    (row.length - 1) * QIDI_BOX_FLOW_UNIT_GAP <= width
+
+  if (fits(units)) return { spoolSize, narrow, compact: false, top: units, bottom: [] }
+
+  const half = Math.ceil(boxCount / 2)
+  const top = units.slice(0, half)
+  const bottom = units.slice(half)
+
+  if (fits(top) && fits(bottom)) return { spoolSize, narrow, compact: false, top, bottom }
+
+  return { spoolSize: 44, narrow: true, compact: true, top: units, bottom: [] }
+}
+
+// The path guide, plus a strand for each filament the sensors see: the hub's from its slot inlet, and the
+// toolhead's along the path to the nozzle. The external spool skips the hub. The compact layout draws only the path.
+export const qidiBoxFlowConnections = (hubSlot: number | null, toolheadSlot: number | null, compact: boolean): QidiBoxFlowConnection[] => {
+  const connections: QidiBoxFlowConnection[] = [{ key: 'guide', via: PATH, dir: 'h', slot: null }]
+
+  if (hubSlot != null && hubSlot !== QIDI_BOX_EXTERNAL_SLOT && !compact) {
+    connections.push({ key: 'hub', via: [`inlet:${hubSlot}`, 'hub'], dir: 'v', slot: hubSlot })
+  }
+
+  if (toolheadSlot === QIDI_BOX_EXTERNAL_SLOT) {
+    if (!compact) connections.push({ key: 'external', via: ['ext', 'th'], dir: 'v', slot: toolheadSlot })
+
+    connections.push({ key: 'toolhead', via: ['th', 'ex', 'noz'], dir: 'h', slot: toolheadSlot })
+  } else if (toolheadSlot != null) {
+    connections.push({ key: 'toolhead', via: PATH, dir: 'h', slot: toolheadSlot })
+  }
+
+  return connections
+}
+
+const round = (value: number) => Math.round(value * 10) / 10
+
+// SVG path data through the points, each step a cubic curve that leaves and enters along the direction, or a
+// straight line when the points already line up.
+export const qidiBoxFlowPath = (points: [number, number][], dir: QidiBoxFlowDirection): string => {
+  if (points.length < 2) return ''
+
+  let d = `M${round(points[0][0])} ${round(points[0][1])}`
+
+  for (let i = 1; i < points.length; i++) {
+    const [x1, y1] = points[i - 1].map(round)
+    const [x2, y2] = points[i].map(round)
+
+    if (dir === 'h' && Math.abs(y2 - y1) > 0.5) {
+      const mid = round((x1 + x2) / 2)
+
+      d += ` C${mid} ${y1} ${mid} ${y2} ${x2} ${y2}`
+    } else if (dir === 'v' && Math.abs(x2 - x1) > 0.5) {
+      const mid = round((y1 + y2) / 2)
+
+      d += ` C${x1} ${mid} ${x2} ${mid} ${x2} ${y2}`
+    } else {
+      d += ` L${x2} ${y2}`
+    }
+  }
+
+  return d
+}
diff --git a/src/util/qidi-box-task.ts b/src/util/qidi-box-task.ts
new file mode 100644
index 0000000..1a00e54
--- /dev/null
+++ b/src/util/qidi-box-task.ts
@@ -0,0 +1,259 @@
+import { QIDI_BOX_EXTERNAL_SLOT, qidiBoxSlotLabel, qidiBoxSlotNumber, type QidiBoxSlot } from './qidi-box'
+
+// QIDI's Box flows (multi_color_controller.task) run a queue of steps. A failed step leaves the task paused on it
+// until FLOW_RETRY reruns it or FLOW_STOP ends the flow.
+
+export interface QidiBoxTask {
+  step: string | null;
+  paused: boolean;
+}
+
+// What a step is doing, as an app.qidi_box.step key and its parameters.
+export interface QidiBoxStepText {
+  key: string;
+  params: Record<string, string | number>;
+}
+
+// The text for a step the card doesn't know.
+export const QIDI_BOX_STEP_UNKNOWN = 'working'
+
+// code is null for an error without a QIDI code.
+export interface QidiBoxError {
+  code: string | null;
+  message: string;
+}
+
+// The slot whose filament a step moves: BOX_ steps act on a Box slot, EXT_ steps on the external spool.
+// BOX_CUT and BOX_WIPE act on whatever is at the toolhead, so their text names no slot.
+const STEPS: Record<string, { action: string, slot: 'active' | 'unloading' | 'external' | null }> = {
+  BOX_HEAT: { action: 'heat', slot: 'active' },
+  BOX_CUT: { action: 'cut', slot: null },
+  BOX_UNLOAD: { action: 'unload', slot: 'unloading' },
+  BOX_LOAD: { action: 'load', slot: 'active' },
+  BOX_WIPE: { action: 'wipe', slot: null },
+  BOX_EJECT: { action: 'eject', slot: 'active' },
+  EXT_HEAT: { action: 'heat', slot: 'external' },
+  EXT_CUT: { action: 'cut', slot: null },
+  EXT_UNLOAD: { action: 'unload', slot: 'external' },
+  EXT_BITE: { action: 'bite', slot: null },
+  EXT_LOAD: { action: 'load', slot: 'external' },
+  EXT_WIPE: { action: 'wipe', slot: null }
+}
+
+// Steps whose text can name their slot, and the heat step, which can also give the nozzle target.
+const SLOT_ACTIONS = ['heat', 'unload', 'load', 'eject']
+
+const boxSlot = (value: unknown): number | null => {
+  const slot = qidiBoxSlotNumber(value)
+
+  return slot != null && slot !== QIDI_BOX_EXTERNAL_SLOT ? slot : null
+}
+
+// A finished flow resets current_queue and current_step but never publishes flow_id going back to null, so judge
+// activity from the fields that do reset.
+export const qidiBoxTask = (printer: Record<string, any>): QidiBoxTask | null => {
+  const task = printer.multi_color_controller?.task
+
+  if (!(task?.current_queue?.length || task?.current_step || task?.is_paused)) return null
+
+  return {
+    step: typeof task.current_step === 'string' && task.current_step !== '' ? task.current_step : null,
+    paused: task.is_paused === true
+  }
+}
+
+// operation.active_slot is the flow's target slot. A load with another slot's filament at the hub first unloads
+// that slot, last_load_slot.
+export const qidiBoxStepSlot = (printer: Record<string, any>, step: string | null): number | null => {
+  const kind = step != null ? STEPS[step]?.slot : null
+  const controller = printer.multi_color_controller
+
+  switch (kind) {
+    case 'external':
+      return QIDI_BOX_EXTERNAL_SLOT
+    case 'unloading':
+      return boxSlot(controller?.box?.last_load_slot ?? printer.save_variables?.variables?.last_load_slot) ??
+        boxSlot(controller?.operation?.active_slot)
+    case 'active':
+      return boxSlot(controller?.operation?.active_slot)
+    default:
+      return null
+  }
+}
+
+export const qidiBoxStepText = (step: string | null, slot: string | null, temp: number | null): QidiBoxStepText => {
+  const action = step != null ? STEPS[step]?.action : null
+
+  if (action == null) return { key: QIDI_BOX_STEP_UNKNOWN, params: {} }
+  if (!SLOT_ACTIONS.includes(action)) return { key: action, params: {} }
+
+  const params: Record<string, string | number> = {}
+  let key = action
+
+  if (action === 'heat' && temp != null) {
+    key += '_temp'
+    params.temp = temp
+  }
+
+  if (step?.startsWith('EXT_')) {
+    key += '_external'
+  } else if (slot != null) {
+    key += '_slot'
+    params.slot = slot
+  }
+
+  return { key, params }
+}
+
+// The running or failed step's text, naming its slot and, while heating, the nozzle target.
+export const qidiBoxTaskText = (printer: Record<string, any>): QidiBoxStepText | null => {
+  const task = qidiBoxTask(printer)
+
+  if (task == null) return null
+
+  const slot = qidiBoxStepSlot(printer, task.step)
+  const label = slot != null ? qidiBoxSlotLabel(slot) : null
+  const target = Number(printer.extruder?.target)
+  const text = qidiBoxStepText(task.step, label, Number.isFinite(target) && target > 0 ? Math.round(target) : null)
+
+  // QIDI's wipe step purges at the chute before it wipes. Valve Oil reports when the first chute wipe starts;
+  // without that report the step stays "wipe".
+  if (text.key === 'wipe' && !task.paused && printer.tltg_box_flow_recovery?.wiping === false) return { key: 'purge', params: {} }
+
+  return text
+}
+
+const ERROR = /Code:\s*(QDE_\d+_\d+)\s*;\s*Message:(.*)$/
+const FAILED_STEP = /\bStep \S+ failed\. Pausing flow\b/
+
+const parseError = (line: string): QidiBoxError | null => {
+  const match = ERROR.exec(line.replace(/<br \/>/g, ' ').trim())
+
+  return match ? { code: match[1], message: match[2].trim() } : null
+}
+
+// A step that raises an error instead of failing is paused by Qidi-Max-4-Optimized with QIDI's
+// `Step BOX_LOAD failed. Pausing flow.`, and Klipper then reports the error, such as
+// `!! Error during homing e_endstop: Communication timeout during homing`.
+const parseRaised = (line: string | undefined): QidiBoxError | null => {
+  if (line == null || !line.startsWith('!!')) return null
+
+  const message = line.replace(/^!!\s*/, '').replace(/<br \/>/g, ' ').trim()
+
+  return message && !ERROR.test(message) ? { code: null, message } : null
+}
+
+// QIDI reports a Box error as `!! Code:QDE_004_006; Message:Extruder loading failure.`, then the flow's
+// `Step BOX_LOAD failed. Pausing flow.` The current failure's error is the latest one since the flow before it
+// failed, so an earlier failure's error is not shown for a step that failed without one. Without a QIDI error,
+// the error Klipper reported right after the failure is used.
+export const qidiBoxLastError = (messages: readonly string[]): QidiBoxError | null => {
+  let failures = 0
+  let raised: QidiBoxError | null = null
+
+  for (let i = messages.length - 1; i >= 0; i--) {
+    const line = messages[i].replace(/^(?:!!|\/\/)\s*/, '')
+
+    if (FAILED_STEP.test(line)) {
+      if (++failures > 1) return raised
+
+      raised = parseRaised(messages[i + 1])
+    }
+
+    const error = parseError(line)
+
+    if (error) return error
+  }
+
+  return raised
+}
+
+// multi_color_controller.box_warning_info lists QIDI's Box heater and sensor warnings.
+export const qidiBoxWarnings = (value: unknown): string[] => {
+  if (!Array.isArray(value)) return []
+
+  const warnings = value.flatMap(warning => {
+    if (warning == null || warning === '') return []
+    if (typeof warning === 'string') {
+      const error = parseError(warning)
+
+      return [error ? `${error.message} (${error.code})` : warning]
+    }
+    if (typeof warning === 'object') {
+      const { message, msg, code } = warning
+      const text = message ?? msg
+
+      if (text != null) return [code != null ? `${text} (${code})` : String(text)]
+    }
+
+    return [JSON.stringify(warning)]
+  })
+
+  return [...new Set(warnings)]
+}
+
+export const qidiBoxHubSensor = (printer: Record<string, any>): number | null => {
+  return printer.box_extras?.b_endstop_state ?? printer.multi_color_controller?.box?.b_endstop_state ?? null
+}
+
+// Filament stopped between the hub and the toolhead, outside a print: the hub sensor sees it and the toolhead
+// sensor doesn't. Qidi-Max-4-Optimized's Unload and Eject then pull back the slot at the hub, even while a failed
+// flow is paused.
+export const qidiBoxStranded = (printer: Record<string, any>): boolean => {
+  return printer['filament_switch_sensor filament_switch_sensor']?.filament_detected === false &&
+    qidiBoxHubSensor(printer) === 0 &&
+    !['printing', 'paused'].includes(printer.print_stats?.state)
+}
+
+// Stranded filament can be unloaded or ejected while no flow runs or a failed flow is paused, unless the Box's
+// button is busy.
+export const qidiBoxStrandedRecovery = (printer: Record<string, any>): boolean => {
+  const task = qidiBoxTask(printer)
+
+  return !printer.box_extras?.box_button_state && (task == null || task.paused) && qidiBoxStranded(printer)
+}
+
+// The slot whose filament is at the hub, picked like Qidi-Max-4-Optimized's Unload and Eject: the slot it recorded
+// at the hub or the last-loaded slot, each only while its inlet has filament, then the only slot with filament at
+// its inlet. Two different named slots can't be told apart.
+export const qidiBoxHubSlot = (printer: Record<string, any>, slots: Pick<QidiBoxSlot, 'index' | 'present'>[]): number | null => {
+  const variables = printer.save_variables?.variables ?? {}
+  const present = slots.filter(slot => slot.index !== QIDI_BOX_EXTERNAL_SLOT && slot.present).map(slot => slot.index)
+  const named = [...new Set([boxSlot(variables.vo_box_hub_slot), boxSlot(variables.last_load_slot)])]
+    .filter((slot): slot is number => slot != null && present.includes(slot))
+
+  if (named.length) return named.length === 1 ? named[0] : null
+
+  return present.length === 1 ? present[0] : null
+}
+
+// The slot feeding the extruder. QIDI's slot_sync names the Box slot synced to the extruder, but QIDI leaves it at
+// 'slot-1' while a Box slot is printing or unloading. With no slot synced and filament at the toolhead, filament at
+// the hub is the Box slot's, picked as for the hub; otherwise it's the external spool's, which doesn't pass the hub.
+// Plus4 Grease: the toolhead's filament sensor. QIDI's newer printers have filament_switch_sensor
+// filament_switch_sensor; the Plus 4 has only hall_filament_width_sensor, which QIDI's runout check reads as filament
+// while its Diameter is above min_diameter (Klipper's default for it is 1.0 mm).
+export const qidiBoxToolheadFilament = (printer: Record<string, any>): boolean => {
+  const toolheadSwitch = printer['filament_switch_sensor filament_switch_sensor']
+
+  if (toolheadSwitch != null) return toolheadSwitch.filament_detected === true
+
+  const hall = printer.hall_filament_width_sensor
+
+  if (hall == null) return false
+
+  const minimum = Number(printer.configfile?.settings?.hall_filament_width_sensor?.min_diameter ?? 1.0)
+  const diameter = Number(hall.Diameter)
+
+  return Number.isFinite(diameter) && diameter > (Number.isFinite(minimum) ? minimum : 1.0)
+}
+
+export const qidiBoxLoadedSlot = (printer: Record<string, any>, slots: Pick<QidiBoxSlot, 'index' | 'present'>[]): number | null => {
+  const sync = printer.save_variables?.variables?.slot_sync
+  const slot = qidiBoxSlotNumber(sync)
+
+  if (slot != null) return slot
+  if (sync !== 'slot-1' || !qidiBoxToolheadFilament(printer)) return null
+
+  return qidiBoxHubSensor(printer) === 0 ? qidiBoxHubSlot(printer, slots) : QIDI_BOX_EXTERNAL_SLOT
+}
diff --git a/src/util/qidi-box.ts b/src/util/qidi-box.ts
new file mode 100644
index 0000000..78a0dbd
--- /dev/null
+++ b/src/util/qidi-box.ts
@@ -0,0 +1,343 @@
+// QIDI Box slots: Box 1 holds slots 0-3 (1A-1D), Box 2 slots 4-7 (2A-2D), and so on; slot 16 is the external spool.
+
+export const QIDI_BOX_EXTERNAL_SLOT = 16
+
+export interface QidiBoxSlot {
+  index: number;
+  label: string;
+  present: boolean;
+  filamentId: string | null;
+  name: string | null;
+  type: string | null;
+  vendor: string | null;
+  color: string | null;
+  minTemp: number | null;
+  maxTemp: number | null;
+  boxMaxTemp: number | null;
+  reading: boolean;
+}
+
+// QIDI's officiall_filas_list.cfg: [filaN] filament entries, [colordict] and [vendor_list] ID maps.
+export type QidiFilamentList = Record<string, Record<string, string>>
+
+// An entry of the firmware filament database (01.01.07.01 filament-0.4.json), keyed by its QF filament ID.
+export interface QidiFilament {
+  id: string;
+  name: string;
+  type: string;
+  vendor: string;
+}
+
+// Loaded Box slots that reload into each other, lettered in slot order.
+export interface QidiBoxReloadGroup {
+  letter: string;
+  color: string | null;
+  members: number[];
+}
+
+export type QidiBoxReloadGroups = Record<number, QidiBoxReloadGroup>
+
+// A Box's aht20_f humidity and temperature, and its heater_generic target while drying.
+export interface QidiBoxClimate {
+  humidity: number | null;
+  temperature: number | null;
+  target: number | null;
+}
+
+export interface QidiBoxTool {
+  tool: number;
+  type: string;
+  color: string;
+}
+
+export interface QidiBoxFileTools {
+  tools: QidiBoxTool[];
+  named: boolean;
+}
+
+// File metadata naming the tools a print uses, from QIDI's Moonraker (used_extruders, preset_colours) or upstream.
+export interface QidiBoxFileMetadata {
+  used_extruders?: number[];
+  referenced_tools?: number[];
+  preset_colours?: string[];
+  filament_colors?: string[];
+  extruder_colors?: string[];
+  filament_type?: string[];
+}
+
+// The tools a file prints with. A file whose metadata names none can select any filament of its slicer project,
+// so all of them are listed, or T0 when the project lists none.
+export const qidiBoxFileTools = (file: QidiBoxFileMetadata): QidiBoxFileTools => {
+  const colors = file.preset_colours ?? file.filament_colors ?? file.extruder_colors ?? []
+  const types = file.filament_type ?? []
+  const listed = [...new Set(file.used_extruders ?? file.referenced_tools ?? [])]
+  const named = listed.length > 0
+  const tools = named ? listed : [...Array(Math.max(colors.length, types.length, 1)).keys()]
+
+  return {
+    tools: tools.map(tool => ({
+      tool,
+      type: types[tool] ?? '',
+      color: colors[tool] ?? ''
+    })),
+    named
+  }
+}
+
+export const qidiBoxSlotLabel = (index: number): string => index === QIDI_BOX_EXTERNAL_SLOT
+  ? 'Ext'
+  : `${Math.floor(index / 4) + 1}${String.fromCharCode(65 + (index % 4))}`
+
+// Saved slot references such as value_tN and slot_sync read 'slotN'.
+export const qidiBoxSlotNumber = (value: unknown): number | null => {
+  const match = /^slot(\d+)$/.exec(String(value ?? ''))
+
+  return match ? parseInt(match[1], 10) : null
+}
+
+export const parseQidiFilamentList = (text: string): QidiFilamentList => {
+  const list: QidiFilamentList = {}
+  let section: Record<string, string> | undefined
+
+  for (const raw of text.split(/\r?\n/)) {
+    const line = raw.trim()
+
+    if (!line || line.startsWith('#')) continue
+
+    const header = /^\[(.+)\]$/.exec(line)
+
+    if (header) {
+      section = list[header[1].trim()] = {}
+    } else if (section) {
+      const separator = line.indexOf('=')
+
+      if (separator > 0) {
+        section[line.slice(0, separator).trim()] = line.slice(separator + 1).trim().replace(/['"]/g, '')
+      }
+    }
+  }
+
+  return list
+}
+
+export const parseQidiFilamentDatabase = (data: unknown): QidiFilament[] => {
+  if (data == null || typeof data !== 'object') return []
+
+  return Object.entries(data as Record<string, Record<string, unknown>>)
+    .filter(([, entry]) => typeof entry?.filament_id === 'string' && /^[A-Z]+\d+$/.test(entry.filament_id))
+    .map(([name, entry]) => ({
+      id: String(entry.filament_id),
+      name,
+      type: String(entry.type ?? ''),
+      vendor: String(entry.filament_vendor ?? '')
+    }))
+}
+
+export const normalizeQidiColor = (value: unknown): string | null => {
+  const color = Array.isArray(value) ? value[0] : value
+  const match = typeof color === 'string' ? /^#?([0-9a-f]{6})$/i.exec(color.trim()) : null
+
+  return match ? `#${match[1].toUpperCase()}` : null
+}
+
+// Black or white, whichever reads better on the color.
+export const qidiTextColor = (color: string | null): string => {
+  const hex = normalizeQidiColor(color)
+
+  if (hex == null) return 'inherit'
+
+  const [r, g, b] = [1, 3, 5].map(offset => parseInt(hex.substring(offset, offset + 2), 16))
+
+  return (r * 299 + g * 587 + b * 114) / 1000 > 125 ? '#000000' : '#FFFFFF'
+}
+
+// A filament close to the card background, black on the dark theme or white on the light one, needs an outline to
+// stay visible.
+export const qidiColorNearBackground = (color: string | null, dark: boolean): boolean => {
+  const hex = normalizeQidiColor(color)
+
+  if (hex == null) return false
+
+  const [r, g, b] = [1, 3, 5].map(offset => parseInt(hex.substring(offset, offset + 2), 16))
+  const luma = (r * 299 + g * 587 + b * 114) / 255000
+
+  return dark ? luma < 0.25 : luma > 0.85
+}
+
+const toNumber = (value: unknown): number | null => {
+  const number = typeof value === 'number' ? value : parseFloat(String(value))
+
+  return Number.isFinite(number) ? number : null
+}
+
+const toText = (value: unknown): string | null => typeof value === 'string' && value.trim() !== '' ? value.trim() : null
+
+// Firmware 01.01.07.01 publishes every slot's resolved filament as box_extras.boxes[].filament_info[];
+// these arrays arrive whole in status updates.
+const resolvedFilament = (printer: Record<string, any>, index: number) => {
+  if (index === QIDI_BOX_EXTERNAL_SLOT) {
+    return printer.multi_color_controller?.extra?.filament_info
+  }
+
+  const infos = printer.box_extras?.boxes?.[Math.floor(index / 4)]?.filament_info
+
+  if (Array.isArray(infos)) {
+    return infos.find(info => info?.index === index % 4) ?? infos[index % 4]
+  }
+}
+
+// Earlier firmware saves numeric IDs that resolve through officiall_filas_list.cfg.
+const legacyFilament = (variables: Record<string, any>, list: QidiFilamentList | null, index: number) => {
+  const filamentId = variables[`filament_slot${index}`]
+  const filament = list?.[`fila${filamentId}`]
+  const colorId = variables[`color_slot${index}`]
+
+  return {
+    filament_id: filamentId != null ? String(filamentId) : null,
+    filament_str: filament?.filament,
+    filament_type: filament?.type,
+    vendor_str: list?.vendor_list?.[variables[`vendor_slot${index}`]],
+    color_rgb_str: typeof colorId === 'number' || /^\d+$/.test(String(colorId))
+      ? list?.colordict?.[colorId]
+      : colorId,
+    min_temp: filament?.min_temp,
+    max_temp: filament?.max_temp,
+    box_max_temp: filament?.box_max_temp
+  }
+}
+
+// Plus4 Grease: the filament list entry with this name. The Plus 4 on V2.1.1 names each slot's filament in
+// box_extras, but its limits may only be in officiall_filas_list.cfg.
+const listedFilament = (list: QidiFilamentList | null, name: unknown): Record<string, string> | undefined => {
+  const wanted = toText(name)?.toLowerCase()
+
+  if (list == null || wanted == null) return undefined
+
+  return Object.entries(list)
+    .find(([key, entry]) => /^fila\d+$/.test(key) && entry.filament?.trim().toLowerCase() === wanted)?.[1]
+}
+
+export const qidiBoxSlots = (printer: Record<string, any>, list: QidiFilamentList | null): QidiBoxSlot[] => {
+  const variables: Record<string, any> = printer.save_variables?.variables ?? {}
+  const boxCount = Math.max(0, Math.min(4, toNumber(variables.box_count) ?? 0))
+  const indexes = [...Array.from({ length: boxCount * 4 }, (_, index) => index), QIDI_BOX_EXTERNAL_SLOT]
+
+  return indexes.map(index => {
+    const info = resolvedFilament(printer, index) ?? legacyFilament(variables, list, index)
+    const listed = listedFilament(list, info?.filament_str)
+    const stepper = printer[`box_stepper slot${index}`]
+
+    return {
+      index,
+      label: qidiBoxSlotLabel(index),
+      // A Box slot's runout_button reads 0 while filament is at its inlet.
+      present: index === QIDI_BOX_EXTERNAL_SLOT || stepper?.runout_button === 0,
+      filamentId: info?.filament_id != null ? String(info.filament_id) : null,
+      name: toText(info?.filament_str),
+      type: toText(info?.filament_type),
+      vendor: toText(info?.vendor_str),
+      color: normalizeQidiColor(info?.color_rgb_str),
+      minTemp: toNumber(info?.min_temp) ?? toNumber(listed?.min_temp),
+      maxTemp: toNumber(info?.max_temp) ?? toNumber(listed?.max_temp),
+      boxMaxTemp: toNumber(info?.box_max_temp) ?? toNumber(listed?.box_max_temp),
+      reading: stepper?.rfid_state === 1
+    }
+  })
+}
+
+// Loaded Box slots with the same color, filament, and vendor reload into each other when one runs out.
+// Groups are lettered in slot order.
+export const qidiBoxReloadGroups = (slots: QidiBoxSlot[]): QidiBoxReloadGroups => {
+  const byKey = new Map<string, number[]>()
+
+  for (const slot of slots) {
+    if (slot.index === QIDI_BOX_EXTERNAL_SLOT || !slot.present) continue
+
+    const key = `${slot.color}-${slot.name}-${slot.vendor}`
+
+    byKey.set(key, [...(byKey.get(key) ?? []), slot.index])
+  }
+
+  const groups: QidiBoxReloadGroups = {}
+
+  Array.from(byKey.values())
+    .filter(members => members.length > 1)
+    .forEach((members, i) => {
+      const group = {
+        letter: String.fromCharCode(65 + i),
+        color: slots.find(slot => slot.index === members[0])?.color ?? null,
+        members
+      }
+
+      members.forEach(member => { groups[member] = group })
+    })
+
+  return groups
+}
+
+const sameType = (a: string | null, b: string) => a != null && a.toUpperCase() === b.trim().toUpperCase()
+
+const colorDistance = (a: string | null, b: string | null): number => {
+  const ca = normalizeQidiColor(a)
+  const cb = normalizeQidiColor(b)
+
+  if (ca == null || cb == null) return Number.MAX_SAFE_INTEGER
+
+  return [1, 3, 5].reduce((sum, offset) => {
+    const delta = parseInt(ca.substring(offset, offset + 2), 16) - parseInt(cb.substring(offset, offset + 2), 16)
+
+    return sum + delta * delta
+  }, 0)
+}
+
+// Loaded Box slots a tool can print from: those holding the same filament type.
+export const qidiBoxSlotsForTool = (tool: QidiBoxTool, slots: QidiBoxSlot[]): QidiBoxSlot[] => slots
+  .filter(slot => slot.index !== QIDI_BOX_EXTERNAL_SLOT && slot.present && sameType(slot.type, tool.type))
+
+// Matches each tool, in order, to the nearest-colored unused slot of its type, as QIDI's Fluidd did.
+// A tool left without an unused slot stays unassigned; it can still share a slot when chosen by hand.
+export const matchQidiBoxSlots = (tools: QidiBoxTool[], slots: QidiBoxSlot[]): Record<number, number | null> => {
+  const used = new Set<number>()
+  const result: Record<number, number | null> = {}
+
+  for (const tool of tools) {
+    const slot = qidiBoxSlotsForTool(tool, slots)
+      .filter(slot => !used.has(slot.index))
+      .sort((a, b) => colorDistance(tool.color, a.color) - colorDistance(tool.color, b.color))[0]
+
+    result[tool.tool] = slot?.index ?? null
+
+    if (slot) used.add(slot.index)
+  }
+
+  return result
+}
+
+export interface QidiBoxToolButton {
+  tool: number;
+  slot: QidiBoxSlot;
+  active: boolean;
+}
+
+// The tools T_MANAGER can load: those mapped to a connected Box slot. It pauses the printer with QDE_004_027 for a
+// tool mapped to the external spool or past the connected Boxes, and an unmapped tool defaults to the external spool.
+// Of the tools mapped to the slot feeding the extruder, extrude_state's (the last tool T_MANAGER selected) is active,
+// or all of them when it names none.
+export const qidiBoxToolButtons = (
+  toolMap: Record<number, number>,
+  slots: QidiBoxSlot[],
+  loadedSlot: number | null,
+  currentTool: number | null
+): QidiBoxToolButton[] => {
+  const buttons = Object.entries(toolMap)
+    .map(([tool, index]) => ({
+      tool: Number(tool),
+      slot: slots.find(slot => slot.index === index && slot.index !== QIDI_BOX_EXTERNAL_SLOT)
+    }))
+    .filter((button): button is { tool: number; slot: QidiBoxSlot } => button.slot != null)
+    .sort((a, b) => a.tool - b.tool)
+  const feeding = buttons.filter(button => button.slot.index === loadedSlot).map(button => button.tool)
+  const active = feeding.includes(currentTool ?? -1) ? [currentTool] : feeding
+
+  return buttons.map(button => ({ ...button, active: active.includes(button.tool) }))
+}
