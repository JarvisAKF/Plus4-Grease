@@ -0,0 +1,70 @@
+import { describe, expect, it } from 'vitest'
+import { qidiBoxCooling, qidiBoxDryLimit, qidiBoxDrySettings, qidiBoxHeaterLimit } from '../qidi-box-dry'
+
+// Plus4 Grease: the card follows plus4-grease-box-dry.cfg's settings, heater limit and cool-down lock.
+describe('Plus 4 Box drying settings', () => {
+  it('uses the defaults without a settings macro (an install from before 0.13)', () => {
+    expect(qidiBoxDrySettings(undefined)).toEqual({
+      plaDrying: false, plaMaxTemp: 45, unlockTemp: 35, coolMinutes: 30
+    })
+  })
+
+  it('reads the macro variables as Moonraker sends them and keeps them in range', () => {
+    expect(qidiBoxDrySettings({ pla_drying: true, pla_max_temp: 90, unlock_temp: 5, cool_minutes: 500 }))
+      .toEqual({ plaDrying: true, plaMaxTemp: 50, unlockTemp: 30, coolMinutes: 120 })
+    expect(qidiBoxDrySettings({ pla_drying: 'no', pla_max_temp: 'x' }))
+      .toMatchObject({ plaDrying: false, plaMaxTemp: 35 })
+  })
+})
+
+describe('Plus 4 Box drying limit', () => {
+  const off = qidiBoxDrySettings({})
+  const on = qidiBoxDrySettings({ pla_drying: true })
+
+  it('is the lowest limit of the filaments in the Box', () => {
+    expect(qidiBoxDryLimit([45, 65], off)).toBe(45)
+    expect(qidiBoxDryLimit([], off)).toBeNull()
+  })
+
+  it('is 0 with PLA or TPU in the Box unless PLA/TPU drying is on', () => {
+    expect(qidiBoxDryLimit([0, 45], off)).toBe(0)
+    expect(qidiBoxDryLimit([0, 65], on)).toBe(45)
+    expect(qidiBoxDryLimit([0], qidiBoxDrySettings({ pla_drying: true, pla_max_temp: 50 }))).toBe(50)
+    expect(qidiBoxDryLimit([0, 45], qidiBoxDrySettings({ pla_drying: true, pla_max_temp: 50 }))).toBe(45)
+  })
+})
+
+describe('Plus 4 Box heater limit (the Thermals target and the card)', () => {
+  const off = qidiBoxDrySettings({})
+  const on = qidiBoxDrySettings({ pla_drying: true })
+
+  it("is QIDI's limit without PLA/TPU drying", () => {
+    expect(qidiBoxHeaterLimit([0, 65], off, false)).toBe(0)
+    expect(qidiBoxHeaterLimit([45, 65], off, true)).toBe(45)
+    expect(qidiBoxHeaterLimit([], off, false)).toBeNull()
+  })
+
+  it('allows PLA/TPU drying up to pla_max_temp when it is on, but not during a print', () => {
+    expect(qidiBoxHeaterLimit([0, 65], on, false)).toBe(45)
+    expect(qidiBoxHeaterLimit([0, 40], on, false)).toBe(40)
+    expect(qidiBoxHeaterLimit([0, 65], on, true)).toBe(0)
+    expect(qidiBoxHeaterLimit([45, 65], on, true)).toBe(45)
+  })
+})
+
+describe('Plus 4 Box cool-down lock', () => {
+  const settings = qidiBoxDrySettings({})
+
+  it('locks while minutes are left, or while above unlock_temp after heating', () => {
+    expect(qidiBoxCooling({ cool_left: 12, hot: 1 }, 41.2, settings)).toEqual({
+      locked: true, minutes: 12, temperature: 41, unlockTemp: 35
+    })
+    expect(qidiBoxCooling({ cool_left: 0, hot: 1 }, 36, settings).locked).toBe(true)
+    expect(qidiBoxCooling({ cool_left: 0, hot: 1 }, 35, settings).locked).toBe(false)
+  })
+
+  it("doesn't lock a warm Box that wasn't heated", () => {
+    expect(qidiBoxCooling({ cool_left: 0, hot: 0 }, 38, settings).locked).toBe(false)
+    expect(qidiBoxCooling(undefined, 50, settings).locked).toBe(false)
+  })
+})
diff --git a/src/util/__tests__/qidi-box-plus4-limits.spec.ts b/src/util/__tests__/qidi-box-plus4-limits.spec.ts
