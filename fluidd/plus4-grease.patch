+import { describe, expect, it } from 'vitest'
+import { PERSONAS, persona, personaCoolingNotice, personaJobLayout, personaJobSpeeds, personaStatusLine, type PersonaStatus } from '../persona'
+
+const idle: PersonaStatus = {
+  klippyReady: true,
+  state: 'standby',
+  filename: '',
+  progress: 0,
+  layer: null,
+  totalLayers: null,
+  speedFactor: 1,
+  heaters: [
+    { name: 'Extruder', temperature: 25, target: 0 },
+    { name: 'Heater Bed', temperature: 24, target: 0 }
+  ],
+  boxes: []
+}
+
+const line = (status: Partial<PersonaStatus>) => personaStatusLine('overdrive', { ...idle, ...status })
+
+describe('Plus4 Grease personas', () => {
+  it('finds a persona by id, and none for Off or an unknown one', () => {
+    expect(persona('overdrive')?.name).toBe('Overdrive')
+    expect(persona('none')).toBeUndefined()
+    expect(persona(undefined)).toBeUndefined()
+    expect(persona('jarvis')).toBeUndefined()
+  })
+
+  it('sets only the four theme colors the settings put back', () => {
+    for (const p of PERSONAS) {
+      expect(Object.keys(p.colors).sort()).toEqual(['appbar', 'btncolor', 'card-heading', 'drawer'])
+    }
+  })
+
+  it('says nothing with the persona off', () => {
+    expect(personaStatusLine('none', idle)).toBe('')
+  })
+})
+
+describe('Overdrive status line', () => {
+  it('idles', () => {
+    expect(line({})).toBe('Idle. Systems armed. Give me something to print.')
+  })
+
+  it('reports Klipper down before anything else', () => {
+    expect(line({ klippyReady: false, state: 'printing' })).toMatch(/^Klipper is down/)
+  })
+
+  it('reports a print with its progress, layers and speed', () => {
+    expect(line({ state: 'printing', filename: 'parts/bracket_v3.gcode', progress: 0.416, layer: 112, totalLayers: 270 }))
+      .toBe('bracket_v3: 41% done. Layer 112 of 270. Holding the line.')
+    expect(line({ state: 'printing', filename: 'a.gcode', progress: 0.5, speedFactor: 1.5 }))
+      .toBe('a: 50% done. Running at 150%.')
+  })
+
+  it('reports heating at the start of a print', () => {
+    expect(line({
+      state: 'printing',
+      filename: 'a.gcode',
+      heaters: [{ name: 'Heater Bed', temperature: 61.4, target: 100 }]
+    })).toBe('Heating Heater Bed: 61 of 100°C. Then we go.')
+  })
+
+  it('reports paused, done, cancelled and error', () => {
+    expect(line({ state: 'paused', filename: 'a.gcode', progress: 0.3 })).toBe('a paused at 30%. Waiting on you.')
+    expect(line({ state: 'complete', filename: 'a.gcode' })).toBe('a done. Clear the plate. Next.')
+    expect(line({ state: 'cancelled', filename: 'a.gcode' })).toBe('a cancelled. Clear the plate.')
+    expect(line({ state: 'error' })).toMatch(/error/)
+  })
+
+  it('reports Box drying, then the cool-down lock, when idle', () => {
+    const box = { box: 1, drying: false, dryTemp: null, locked: false, coolMinutes: 0, temperature: 30 }
+
+    expect(line({ boxes: [{ ...box, drying: true, dryTemp: 45 }] })).toBe('Box 1 drying at 45°C. Moisture is the enemy.')
+    expect(line({ boxes: [{ ...box, locked: true, coolMinutes: 12, temperature: 41.6 }] }))
+      .toBe('Box 1 cooling at 42°C. PLA and TPU stay locked. 12 min left.')
+    expect(line({ boxes: [box] })).toMatch(/^Idle/)
+  })
+
+  it('reports heaters warming up when idle', () => {
+    expect(line({ heaters: [{ name: 'Extruder', temperature: 150, target: 220 }] }))
+      .toBe('Heating Extruder: 150 of 220°C.')
+    expect(line({ heaters: [{ name: 'Extruder', temperature: 219, target: 220 }] })).toMatch(/^Idle/)
+  })
+})
+
+describe("Overdrive's print job card", () => {
+  const job = {
+    filename: 'parts/bracket_v3.gcode',
+    state: 'printing',
+    progress: 41.6,
+    layer: 112,
+    totalLayers: 270,
+    left: 2569.4,
+    layerHeight: 0.2,
+    slicer: 'QIDIStudio'
+  }
+
+  it('lays out a running print', () => {
+    expect(personaJobLayout(job)).toEqual({
+      name: 'bracket_v3',
+      subline: '0.2 MM LAYERS · QIDISTUDIO',
+      done: false,
+      progress: 41,
+      segments: 16,
+      layerText: 'LAYER 112/270',
+      left: 2569
+    })
+  })
+
+  it('fills every segment when done and says when it was cancelled', () => {
+    expect(personaJobLayout({ ...job, state: 'complete', progress: 99.7 }))
+      .toMatchObject({ done: true, progress: 100, segments: 40, layerText: 'LAYER 270/270', left: 0 })
+    expect(personaJobLayout({ ...job, state: 'cancelled', slicer: null }).subline).toBe('0.2 MM LAYERS · CANCELLED')
+  })
+
+  it('copes without layers, metadata or a sane progress', () => {
+    expect(personaJobLayout({ ...job, totalLayers: null, layer: null, layerHeight: null, slicer: null, progress: 140 }))
+      .toMatchObject({ layerText: 'LAYER —', subline: '', progress: 100, segments: 40 })
+  })
+
+  it('has the four speed buttons, ending at MAX', () => {
+    expect(personaJobSpeeds.map(s => s.value)).toEqual([100, 140, 180, 220])
+  })
+
+  it('words the cool-down notice', () => {
+    expect(personaCoolingNotice(1, 38.4, 35, 12))
+      .toBe('Print start locked: Box 1 holds PLA or TPU and is cooling after heating. 38° now, it unlocks at 35°, in about 12 min.')
+    expect(personaCoolingNotice(2, null, 35, 0))
+      .toBe('Print start locked: Box 2 holds PLA or TPU and is cooling after heating. It unlocks at 35°.')
+  })
+})
