diff --git a/src/mixins/qidiBox.ts b/src/mixins/qidiBox.ts
new file mode 100644
index 0000000..f2f6d2f
--- /dev/null
+++ b/src/mixins/qidiBox.ts
@@ -0,0 +1,35 @@
+import { Component, Mixins, Watch } from 'vue-property-decorator'
+import { consola } from 'consola'
+import FilesMixin from './files'
+import { parseQidiFilamentList } from '@/util/qidi-box'
+
+// Plus4 Grease, from Valve Oil's Fluidd: reads QIDI's officiall_filas_list.cfg from the config folder once Klipper
+// is ready, for each filament's nozzle and Box temperature limits. Valve Oil also reads the newer firmware's filament
+// database; the Plus 4 on V2.1.1 has none.
+@Component
+export default class QidiBoxMixin extends Mixins(FilesMixin) {
+  // Once Klipper is ready and has reported a Box.
+  get qidiBoxFilamentsWanted (): boolean {
+    return this.$typedGetters['printer/getKlippyReady'] && this.$typedGetters['qidiBox/getBoxCount'] > 0
+  }
+
+  @Watch('qidiBoxFilamentsWanted', { immediate: true })
+  onQidiBoxFilamentsWanted (wanted: boolean) {
+    if (wanted) this.loadQidiBoxFilaments()
+  }
+
+  async loadQidiBoxFilaments () {
+    if (this.$typedState.qidiBox.filamentList != null) return
+
+    try {
+      const response = await this.serverFilesGet<string>('config/officiall_filas_list.cfg', {
+        responseType: 'text',
+        transformResponse: [(value: string) => value]
+      })
+
+      this.$typedCommit('qidiBox/setFilamentList', parseQidiFilamentList(response.data))
+    } catch (error) {
+      consola.debug('[QidiBox] filament list unavailable', error)
+    }
+  }
+}
