diff --git a/src/components/widgets/qidiBox/QidiBoxSettingsDialog.vue b/src/components/widgets/qidiBox/QidiBoxSettingsDialog.vue
new file mode 100644
index 0000000..8674381
--- /dev/null
+++ b/src/components/widgets/qidiBox/QidiBoxSettingsDialog.vue
@@ -0,0 +1,83 @@
+<template>
+  <app-dialog
+    v-model="open"
+    :title="$t('app.qidi_box.settings.title')"
+    width="720"
+    no-actions
+  >
+    <v-card-text class="pa-0">
+      <template v-for="(setting, i) in settings">
+        <v-divider
+          v-if="i > 0"
+          :key="`divider-${setting.variable}`"
+        />
+        <app-setting
+          :key="setting.variable"
+          :title="$t(`app.qidi_box.settings.${setting.variable}`)"
+          :sub-title="$t(`app.qidi_box.settings.${setting.variable}_help`)"
+        >
+          <v-switch
+            :input-value="setting.value"
+            :disabled="!klippyReady"
+            class="mt-0"
+            hide-details
+            @change="save(setting.variable, $event)"
+          />
+        </app-setting>
+      </template>
+      <v-divider />
+      <app-setting
+        :title="$t('app.qidi_box.self_check.title')"
+        :sub-title="$t('app.qidi_box.self_check.help')"
+      >
+        <app-btn
+          small
+          :disabled="selfCheckDisabled"
+          @click="selfCheck"
+        >
+          {{ $t('app.qidi_box.self_check.run') }}
+        </app-btn>
+      </app-setting>
+    </v-card-text>
+  </app-dialog>
+</template>
+
+<script lang="ts">
+// Plus4 Grease: QIDI's three Box settings, from Valve Oil's Fluidd. They're saved variables QIDI's Box modules read,
+// set exactly as QIDI's own Fluidd sets them on the Plus 4's V2.1.1: SAVE_VARIABLE VARIABLE=<name> VALUE="1" or "0".
+// The self-check sends BOX_SELF_INSPECTION, as QIDI's touchscreen does.
+import { Component, Mixins, VModel } from 'vue-property-decorator'
+import StateMixin from '@/mixins/state'
+import { Waits } from '@/globals'
+
+const VARIABLES = ['auto_read_rfid', 'auto_init_detect', 'auto_reload_detect']
+
+@Component({})
+export default class QidiBoxSettingsDialog extends Mixins(StateMixin) {
+  @VModel({ type: Boolean })
+  open!: boolean
+
+  get settings () {
+    const variables = this.$typedState.printer.printer.save_variables?.variables ?? {}
+
+    return VARIABLES.map(variable => ({ variable, value: Number(variables[variable] ?? 0) === 1 }))
+  }
+
+  get selfCheckDisabled (): boolean {
+    const state: string = this.$typedState.printer.printer.print_stats?.state ?? ''
+
+    return !this.klippyReady || this.$typedGetters['qidiBox/getBusy'] || this.hasWait(Waits.onQidiBoxCommand) ||
+      state === 'printing' || state === 'paused'
+  }
+
+  selfCheck () {
+    if (this.selfCheckDisabled) return
+
+    this.sendGcode('BOX_SELF_INSPECTION', Waits.onQidiBoxCommand)
+  }
+
+  save (variable: string, value: boolean) {
+    this.sendGcode(`SAVE_VARIABLE VARIABLE=${variable} VALUE="${value ? 1 : 0}"`)
+  }
+}
+</script>
diff --git a/src/components/widgets/qidiBox/QidiBoxSpool.vue b/src/components/widgets/qidiBox/QidiBoxSpool.vue
