diff --git a/src/components/layout/AppPersonaStatus.vue b/src/components/layout/AppPersonaStatus.vue
new file mode 100644
index 0000000..086cefc
--- /dev/null
+++ b/src/components/layout/AppPersonaStatus.vue
@@ -0,0 +1,113 @@
+<template>
+  <div
+    v-if="line"
+    class="persona-status"
+    role="status"
+    :title="line"
+  >
+    <span class="persona-status__label">{{ label }}</span>
+    <span class="persona-status__text">{{ line }}</span>
+  </div>
+</template>
+
+<script lang="ts">
+import { Component, Mixins } from 'vue-property-decorator'
+import StateMixin from '@/mixins/state'
+import type { ThemeConfig } from '@/store/config/types'
+import type { Heater } from '@/store/printer/types'
+import { persona, personaStatusLine, type PersonaBox, type PersonaStatus } from '@/util/persona'
+import { qidiBoxCooling, qidiBoxDrySettings } from '@/util/qidi-box-dry'
+
+// Plus4 Grease: the persona's line in the top bar, saying what the printer is doing.
+@Component({})
+export default class AppPersonaStatus extends Mixins(StateMixin) {
+  get theme (): ThemeConfig {
+    return this.$typedState.config.uiSettings.theme
+  }
+
+  get label (): string {
+    return persona(this.theme.persona)?.label ?? ''
+  }
+
+  get boxes (): PersonaBox[] {
+    const printer = this.$typedState.printer.printer
+    const settings = qidiBoxDrySettings(printer['gcode_macro _GREASE_BOX_DRY_SETTINGS'])
+    const count: number = this.$typedGetters['qidiBox/getBoxCount'] ?? 0
+    const boxes: PersonaBox[] = []
+
+    for (let box = 1; box <= count; box++) {
+      const state = printer[`gcode_macro _GREASE_BOX_DRY_${box}`]
+
+      if (state == null) continue
+
+      const temperature: number | null = printer[`heater_generic heater_box${box}`]?.temperature ?? null
+      const cooling = qidiBoxCooling(state, temperature, settings)
+
+      boxes.push({
+        box,
+        drying: Number(state.active ?? 0) === 1,
+        dryTemp: Number(state.temp ?? 0) || null,
+        locked: cooling.locked,
+        coolMinutes: cooling.minutes,
+        temperature
+      })
+    }
+
+    return boxes
+  }
+
+  get status (): PersonaStatus {
+    const printer = this.$typedState.printer.printer
+    const heaters: Heater[] = this.$typedGetters['printer/getHeaters'] ?? []
+    const layers: number = this.$typedGetters['printer/getPrintLayers'] ?? 0
+
+    return {
+      klippyReady: this.klippyReady,
+      state: printer.print_stats?.state ?? '',
+      filename: printer.print_stats?.filename ?? '',
+      progress: this.$typedGetters['printer/getPrintProgress'] ?? 0,
+      layer: layers > 0 ? this.$typedGetters['printer/getPrintLayer'] : null,
+      totalLayers: layers > 0 ? layers : null,
+      speedFactor: printer.gcode_move?.speed_factor ?? 1,
+      heaters: heaters.map(heater => ({
+        name: heater.prettyName,
+        temperature: heater.temperature,
+        target: heater.target
+      })),
+      boxes: this.boxes
+    }
+  }
+
+  get line (): string {
+    return personaStatusLine(this.theme.persona, this.status)
+  }
+}
+</script>
+
+<style lang="scss" scoped>
+  .persona-status {
+    display: flex;
+    align-items: baseline;
+    gap: 8px;
+    min-width: 0;
+    flex: 1 1 auto;
+    margin: 0 12px;
+    font-size: 13px;
+    font-weight: 500;
+    white-space: nowrap;
+    overflow: hidden;
+  }
+
+  .persona-status__label {
+    flex-shrink: 0;
+    font-weight: 700;
+    letter-spacing: 0.14em;
+    color: var(--v-primary-base);
+  }
+
+  .persona-status__text {
+    overflow: hidden;
+    text-overflow: ellipsis;
+    opacity: 0.85;
+  }
+</style>
